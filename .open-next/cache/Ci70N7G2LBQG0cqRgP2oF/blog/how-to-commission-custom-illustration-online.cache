}],[\"$\",\"span\",null,{\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"February 10, 2025\"}],[\"$\",\"span\",null,{\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"5 min read\"}]]}],[\"$\",\"h1\",null,{\"className\":\"font-anton text-4xl sm:text-5xl md:text-6xl uppercase leading-tight text-[var(--ink)] mt-2\",\"children\":\"How to Commission Custom Illustration Art Online\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mt-6 pt-4 border-t border-[var(--ink)]/20 font-mono text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[var(--muted)] uppercase\",\"children\":\"Written by:\"}],[\"$\",\"span\",null,{\"className\":\"font-bold text-[var(--ink)]\",\"children\":\"Jhay Sanyay\"}]]}]]}]}],[\"$\",\"article\",null,{\"className\":\"py-16 bg-[var(--ink)] text-[var(--paper)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-3xl space-y-8 font-sans text-lg leading-relaxed text-[var(--paper-2)]/90\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative aspect-[16/9] w-full border-2 border-[var(--paper-2)]/30 overflow-hidden mb-10 shadow-2xl\",\"children\":[\"$\",\"$L4\",null,{\"src\":\"/images/illustrations/cover-02.jpg\",\"alt\":\"How to Commission Custom Illustration Art Online\",\"fill\":true,\"sizes\":\"(max-width: 1024px) 100vw, 800px\",\"className\":\"object-cover\",\"priority\":true}]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Not every commission starts with an album or a manga chapter. Sometimes you just want a piece — a character portrait, a personal avatar, concept art for a project that isn't fully defined yet, or a gift for someone. Custom illustration is one of the most flexible things you can commission, and also one of the easiest to get wrong if you go in without a plan.\"]}],[\"$\",\"p\",\"2\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Here's how to commission custom illustration online, from figuring out what you actually want to receiving the final file.\"]}],[\"$\",\"hr\",\"4\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}],[\"$\",\"h2\",\"6\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"What Counts as \\\"Custom Illustration\\\"\"}],[\"$\",\"p\",\"8\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Unlike album covers or manga covers, which have fairly fixed formats, custom illustration covers a wide range of requests:\"]}],[\"$\",\"li\",\"10\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Character portraits\"}],\" — original characters, D&D characters, personal avatars\"]}],[\"$\",\"li\",\"11\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Concept art\"}],\" — early visual development for a game, comic, or story before anything else exists\"]}],[\"$\",\"li\",\"12\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Fan art commissions\"}],\" — a specific character from an existing work, done in the artist's style\"]}],\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\"]}],\"$L34\"]}]}],\"$L35\",\"$L36\"]}],[\"$L37\"],\"$L38\"]}],\"isPartial\