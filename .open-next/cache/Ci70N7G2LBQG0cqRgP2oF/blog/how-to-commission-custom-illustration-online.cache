{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[slug]/layout,_N_T_/blog/[slug]/page,_N_T_/blog/how-to-commission-custom-illustration-online"},"segmentPaths":["/_tree","/_full","/blog/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"anton_3de222df-module__cdpv1W__variable work_sans_884a743-module__CqIiYG__variable space_mono_82b93b41-module__X9D-ya__variable h-full antialiased\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/7ddd198311ba7843-s.p.3kq6k02b2ysv1.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/8d05cfa5faa8406c-s.p.1s123piy9_v1m.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/9e9f04e3c37952ab-s.p.0pan85mumqyf3.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/dc0d9adbac686440-s.p.3cik_s2si-ft-.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=3840&amp;q=75 3840w\" imageSizes=\"(max-width: 1024px) 100vw, 800px\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2b2j6nos8u62l.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3s6nzrbk-8mnv.js\"/><script src=\"/_next/static/chunks/2eg0ks0feyohg.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mkbuudhndal5.js\" async=\"\"></script><script src=\"/_next/static/chunks/2-rtuqsgzmno4.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0d8_zlqdf5yql.js\" async=\"\"></script><script src=\"/_next/static/chunks/0h2qsuyze9ds1.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/3ykrlu0oa3rkw.js\" async=\"\" crossorigin=\"\"></script><title>How to Commission Custom Illustration Art Online (2026 Guide) | Jhay Sanyay Studio</title><meta name=\"description\" content=\"Thinking about commissioning a custom illustration? Here&#x27;s how the process works, what it costs, and how to find and hire the right digital artist.\"/><meta name=\"author\" content=\"Jhay Sanyay\"/><meta name=\"keywords\" content=\"commission custom illustration online,hire digital illustrator\"/><meta name=\"creator\" content=\"Jhay Sanyay\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-image-preview:large, max-snippet:-1\"/><meta property=\"og:title\" content=\"How to Commission Custom Illustration Art Online (2026 Guide)\"/><meta property=\"og:description\" content=\"Thinking about commissioning a custom illustration? Here&#x27;s how the process works, what it costs, and how to find and hire the right digital artist.\"/><meta property=\"og:url\" content=\"https://jhaysanyay.com/blog/how-to-commission-custom-illustration-online\"/><meta property=\"og:image\" content=\"https://jhaysanyay.com/images/illustrations/cover-02.jpg\"/><meta property=\"og:image:alt\" content=\"How to Commission Custom Illustration Art Online\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2025-02-09T23:00:00.000Z\"/><meta property=\"article:author\" content=\"Jhay Sanyay\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:creator\" content=\"@jhaysanyay\"/><meta name=\"twitter:title\" content=\"How to Commission Custom Illustration Art Online (2026 Guide)\"/><meta name=\"twitter:description\" content=\"Thinking about commissioning a custom illustration? Here&#x27;s how the process works, what it costs, and how to find and hire the right digital artist.\"/><meta name=\"twitter:image\" content=\"https://jhaysanyay.com/images/illustrations/cover-02.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/icon.svg?icon.1hqt-6fdfs6lm.svg\" sizes=\"any\" type=\"image/svg+xml\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col font-sans bg-[var(--ink)] color-[var(--paper)]\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen flex flex-col bg-[var(--ink)]\"><header class=\"sticky top-0 z-40 bg-[var(--ink)] border-b-2 border-[var(--paper-2)] text-[var(--paper)] py-4\"><div class=\"wrap flex flex-wrap justify-between items-center gap-4\"><a class=\"font-anton text-2xl tracking-wider text-[var(--paper)] hover:text-[var(--yellow)] transition-colors relative group\" href=\"/\">JHAY <span class=\"text-[var(--red)] font-bold\">·</span> SANYAY</a><nav class=\"flex items-center gap-4 sm:gap-6 font-mono text-xs text-[var(--paper-2)] tracking-widest uppercase\"><a class=\"text-[var(--paper)] hover:text-[var(--yellow)] font-bold transition-colors\" href=\"/portfolio\">Portfolio</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/blog\">Guides</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/#prices\">Prices</a><a class=\"text-[var(--yellow)] border border-[var(--yellow)] px-3 py-1 hover:bg-[var(--yellow)] hover:text-[var(--ink)] transition-all duration-300 active:scale-95\" href=\"/#order\">Book Ticket</a></nav></div></header><section class=\"bg-[var(--paper)] py-12 border-b-2 border-[var(--ink)] text-[var(--ink)]\"><div class=\"wrap max-w-4xl\"><a class=\"font-mono text-xs text-[var(--red)] uppercase font-bold tracking-wider hover:underline inline-block mb-6\" href=\"/blog\">← Back to All Guides</a><div class=\"flex items-center gap-3 font-mono text-xs text-[var(--muted)] mb-3\"><span class=\"bg-[var(--ink)] text-[var(--paper)] font-bold px-2 py-0.5 uppercase tracking-widest text-[10px]\">Illustration Guide</span><span>•</span><span>February 10, 2025</span><span>•</span><span>5 min read</span></div><h1 class=\"font-anton text-4xl sm:text-5xl md:text-6xl uppercase leading-tight text-[var(--ink)] mt-2\">How to Commission Custom Illustration Art Online</h1><div class=\"flex items-center gap-3 mt-6 pt-4 border-t border-[var(--ink)]/20 font-mono text-xs\"><span class=\"text-[var(--muted)] uppercase\">Written by:</span><span class=\"font-bold text-[var(--ink)]\">Jhay Sanyay</span></div></div></section><article class=\"py-16 bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-3xl space-y-8 font-sans text-lg leading-relaxed text-[var(--paper-2)]/90\"><div class=\"relative aspect-[16/9] w-full border-2 border-[var(--paper-2)]/30 overflow-hidden mb-10 shadow-2xl\"><img alt=\"How to Commission Custom Illustration Art Online\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 800px\" srcSet=\"/_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fillustrations%2Fcover-02.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"space-y-4\"><p class=\"mb-4 font-sans leading-relaxed\">Not every commission starts with an album or a manga chapter. Sometimes you just want a piece — a character portrait, a personal avatar, concept art for a project that isn&#x27;t fully defined yet, or a gift for someone. Custom illustration is one of the most flexible things you can commission, and also one of the easiest to get wrong if you go in without a plan.</p><p class=\"mb-4 font-sans leading-relaxed\">Here&#x27;s how to commission custom illustration online, from figuring out what you actually want to receiving the final file.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">What Counts as &quot;Custom Illustration&quot;</h2><p class=\"mb-4 font-sans leading-relaxed\">Unlike album covers or manga covers, which have fairly fixed formats, custom illustration covers a wide range of requests:</p><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Character portraits</strong> — original characters, D&amp;D characters, personal avatars</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Concept art</strong> — early visual development for a game, comic, or story before anything else exists</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Fan art commissions</strong> — a specific character from an existing work, done in the artist&#x27;s style</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Gift commissions</strong> — art of a person, pet, or scene for someone else</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Promotional/key art</strong> — a single striking piece used for marketing rather than a specific product cover</li><p class=\"mb-4 font-sans leading-relaxed\">Because the category is broad, being specific about <em class=\"italic text-[var(--yellow)]\">which</em> of these you want is the first thing that determines price, timeline, and which artist is actually the right fit.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 1: Figure Out What You&#x27;re Actually Asking For</h2><p class=\"mb-4 font-sans leading-relaxed\">Before contacting an artist, answer these for yourself:</p><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Is this a <strong class=\"font-bold text-[var(--paper)]\">finished, standalone piece</strong>, or an early step in a larger project (like concept art before a full cover)?</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Does it need to match an <strong class=\"font-bold text-[var(--paper)]\">existing visual style</strong> — your own brand, a game&#x27;s art direction, a series you&#x27;re building?</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">What&#x27;s the <strong class=\"font-bold text-[var(--paper)]\">end use</strong>? Personal, print, commercial, social media — usage matters for both pricing and rights.</li><p class=\"mb-4 font-sans leading-relaxed\">Artists often quote differently for personal-use pieces versus commercial ones, so being upfront about intended use avoids a renegotiation later.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 2: Build References Even for an Open-Ended Piece</h2><p class=\"mb-4 font-sans leading-relaxed\">Even a loosely defined commission benefits enormously from references. Bring:</p><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">2–3 pieces (any artist, any style) that capture the mood or energy you want</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Any fixed details that must be included — specific colors, objects, a character&#x27;s known appearance</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">A rough sense of composition: portrait, full scene, close-up</li><p class=\"mb-4 font-sans leading-relaxed\">Illustrators who also work across album covers and manga — such as Jhay Sanyay — bring the same structured process to open-ended illustration work, so a clear reference set still gets you a fast, accurate quote even without a fixed format.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 3: What Custom Illustration Typically Costs</h2><p class=\"mb-4 font-sans leading-relaxed\">Because scope varies more here than in fixed-format work, expect pricing to scale with:</p><div class=\"overflow-x-auto my-8 border-2 border-[var(--paper-2)]/30\"><table class=\"w-full text-left border-collapse font-mono text-sm\"><thead><tr class=\"bg-[var(--paper)] text-[var(--ink)] font-bold\"><th class=\"p-3 border border-[var(--ink)]\">Factor</th><th class=\"p-3 border border-[var(--ink)]\">Effect on Price</th></tr></thead><tbody><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Number of characters</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Each additional character adds cost</td></tr><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Background complexity</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Simple/no background is cheaper than a full scene</td></tr><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Detail level</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Flat color vs. full rendering/lighting changes turnaround and price</td></tr><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Commercial usage rights</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Commercial licensing typically costs more than personal use</td></tr></tbody></table></div><p class=\"mb-4 font-sans leading-relaxed\">Turnaround for a single-character illustration is often 3–10 days depending on complexity; multi-character scenes can take 2+ weeks.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 4: What to Look for in an Illustrator</h2><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Range across the type of work you want</strong> — a portfolio full of covers doesn&#x27;t always mean strong standalone character work, and vice versa; look for actual examples close to your ask</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">A clear commission/booking process</strong> — reduces ambiguity on price, timeline, and revisions</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Willingness to do a sketch-approval stage</strong> — critical for open-ended pieces where composition isn&#x27;t fixed yet</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Clarity on usage rights upfront</strong> — personal vs. commercial use should be discussed before, not after, delivery</li><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 5: The Process, Start to Finish</h2><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Brief submission</strong> — references, intended use, any fixed details</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Quote and scope confirmation</strong> — price and timeline based on complexity</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Sketch stage</strong> — rough composition for approval</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Rendering</strong> — full linework, color, and detail pass</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Revisions</strong> — within agreed rounds</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Final delivery</strong> — high-resolution file(s) in the format you need</li><p class=\"mb-4 font-sans leading-relaxed\">This is close to the same structure used for album and manga cover commissions — Jhay&#x27;s <a href=\"/#order\" class=\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\">commission page</a> runs illustration work through this same brief-to-delivery flow, which keeps open-ended pieces from turning into open-ended timelines.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Common Mistakes</h2><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Being too open-ended in the brief</strong> — &quot;surprise me&quot; sounds fun but usually leads to more revisions, not fewer</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Not clarifying usage rights</strong> — assuming personal-use pricing covers commercial use (or the reverse) causes friction later</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Skipping the sketch-approval step</strong> — especially risky on illustration work since composition isn&#x27;t fixed the way a cover format is</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Underestimating multi-character pricing</strong> — each added character is realistically its own piece of work, not a minor add-on</li><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Final Thoughts</h2><p class=\"mb-4 font-sans leading-relaxed\">Custom illustration is the most flexible type of commission, which is exactly why it needs the most upfront clarity — on scope, usage, and references — to go smoothly. A good brief and a clear process turn an open-ended idea into a piece that actually matches what you had in mind.</p><p class=\"mb-4 font-sans leading-relaxed\">If you&#x27;re looking to commission custom illustration, character art, or concept work, <a href=\"/#order\" class=\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\">Jhay Sanyay Studio</a> takes on illustration commissions alongside album and manga cover work, with a structured process from brief to final delivery.</p></div><div class=\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--ink)] shadow-[10px_10px_0_var(--red)]\"><div class=\"font-mono text-xs text-[var(--red)] font-bold uppercase tracking-widest mb-1\">Ready to Commission?</div><h3 class=\"font-anton text-3xl uppercase mb-3\">Get Your Custom Artwork Stamped</h3><p class=\"text-sm font-sans text-[var(--muted)] mb-6\">Jhay Sanyay Studio handles custom cover art, manga/comic illustrations, and logo design from brief submission to final delivery. Fill out your job ticket below for a 48-hour quote.</p><a href=\"#order\" class=\"stamp-btn inline-block !py-3 !px-6\">FILL OUT JOB TICKET</a></div></div></article><section id=\"order\" class=\"ticket-build-section py-[72px] bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-[800px] mx-auto\"><div class=\"section-head mb-8 text-center\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"eyebrow font-mono text-xs text-[var(--yellow)] tracking-[0.12em] uppercase mb-[18px] inline-flex items-center gap-[10px] before:content-[&#x27;&#x27;] before:w-5 before:h-[2px] before:bg-[var(--yellow)] after:content-[&#x27;&#x27;] after:w-5 after:h-[2px] after:bg-[var(--yellow)]\">Commission Order Form</div><h2 class=\"text-[clamp(36px,6vw,56px)] font-anton uppercase text-[var(--paper)]\">Create Job Ticket</h2></div><div class=\"ticket relative bg-[var(--ink)] color-[var(--paper)] border-2 border-[var(--paper)] p-6 md:p-12 shadow-[12px_12px_0_var(--red)]\" style=\"opacity:0;transform:scale(0.95)\"><div class=\"notch tl\"></div><div class=\"notch tr\"></div><div class=\"notch bl\"></div><div class=\"notch br\"></div><div class=\"ticket-header flex justify-between items-center border-b-2 border-dashed border-[var(--paper-2)] pb-4 mb-8\"><div class=\"font-anton text-2xl tracking-wider text-[var(--yellow)]\">JHAY SANYAY STUDIO</div><div class=\"font-mono text-xs md:text-sm text-[var(--paper-2)] tracking-widest uppercase\">TICKET NO: <span class=\"font-bold text-[var(--red)]\"></span></div></div><form class=\"space-y-6\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Client / Stage Name <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. Starboy / Divine\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Email or Social Handle <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. @artist / email@domain.com\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Service Category</label><select class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y