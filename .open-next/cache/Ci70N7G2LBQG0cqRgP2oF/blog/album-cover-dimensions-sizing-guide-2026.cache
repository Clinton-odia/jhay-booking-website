[\"72–300 DPI\"]}],[\"$\",\"td\",\"3\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"RGB\"]}]]}],[\"$\",\"tr\",\"1\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Vinyl 12\\\" sleeve\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"12.5 x 12.5 in (with bleed)\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"300 DPI\"]}],[\"$\",\"td\",\"3\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"CMYK\"]}]]}],[\"$\",\"tr\",\"2\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"CD front cover\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"4.72 x 4.72 in (with bleed)\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"300 DPI\"]}],[\"$\",\"td\",\"3\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"CMYK\"]}]]}],[\"$\",\"tr\",\"3\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Social media thumbnail crop\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"1080 x 1080px\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"72 DPI\"]}],[\"$\",\"td\",\"3\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"RGB\"]}]]}]]}]]}]}]\n1d:[\"$\",\"hr\",\"38\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\n1e:[\"$\",\"h2\",\"40\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Why This Matters Before You Commission, Not After\"}]\n1f:[\"$\",\"p\",\"42\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"The single biggest mistake is deciding on final format \",[\"$\",\"em\",\"1\",{\"className\":\"italic text-[var(--yellow)]\",\"children\":\"after\"}],\" a cover is already finished. Print (CMYK) and digital (RGB) color don't translate 1:1 — a color that looks vivid on screen can shift when converted to CMYK for print. If there's any chance a cover will go to vinyl or CD, say so at the brief stage so the artist can work in the right color mode from the start, rather than converting after the fact.\"]}]\n20:[\"$\",\"p\",\"44\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"A structured commission process — like the one used for \",[\"$\",\"a\",\"1\",{\"href\":\"/#order\",\"className\":\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\",\"children\":\"album, manga, and illustration work here\"}],\" — will typically ask about final format upfront for exactly this reason.\"]}]\n21:[\"$\",\"h2\",\"46\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Manga and Book Cover Specs (For Comparison)\"}]\n22:[\"$\",\"p\",\"48\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Manga and book covers follow a different logic since they're rarely square:\"]}]\n23:[\"$\",\"li\",\"50\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Digital manga/webtoon cover:\"}],\" typically 1600 x 2560px (varies by platform — always check the specific platform's spec sheet)\"]}]\n24:[\"$\",\"li\",\"51\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Print book cover (trade paperback):\"}],\" varies by trim size, but 300 DPI CMYK with bleed is standard across the board\"]}]\n25:[\"$\",\"hr\",\"53\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\n26:[\"$\",\"h2\",\"55\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Final Thoughts\"}]\n27:[\"$\",\"p\",\"57\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Getting dimensions right isn't the creative part of a commission, but it's the part that determines whether the creative work actually holds up across every place it needs to appear — a streaming thumbnail, a printed sleeve, a social post. Confirm the final use case before work starts, and the rest of the process gets a lot simpler.\"]}]\n28:[\"$\",\"div\",null,{\"className\":\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--ink)] shadow-[10px_10px_0_var(--red)]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-mono text-xs text-[var(--red)] font-bold uppercase tracking-widest mb-1\",\"children\":\"Ready to Commission?\"}],[\"$\",\"h3\",null,{\"className\":\"font-anton text-3xl uppercase mb-3\",\"children\":\"Get Your Custom Artwork Stamped\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-sans text-[var(--muted)] mb-6\",\"children\":\"Jhay Sanyay Studio handles custom cover art, manga/comic illustrations, and logo design from brief submission to final delivery. Fill out your job ticket below for a 48-hour quote.\"}],[\"$\",\"a\",null,{\"href\":\"#order\",\"className\":\"stamp-btn inline-block !py-3 !px-6\",\"childr