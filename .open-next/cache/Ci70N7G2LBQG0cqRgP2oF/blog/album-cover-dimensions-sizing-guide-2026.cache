sions and Specs: The Complete 2026 Sizing Guide\",\"fill\":true,\"sizes\":\"(max-width: 1024px) 100vw, 800px\",\"className\":\"object-cover\",\"priority\":true}]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"A finished cover getting rejected by a distributor, or looking soft and pixelated on a streaming thumbnail, is almost always a sizing problem — not a quality problem. Here are the exact specs to confirm before a single pixel gets rendered.\"]}],[\"$\",\"hr\",\"2\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}],[\"$\",\"h2\",\"4\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Streaming Platforms (Spotify, Apple Music, and Most DSPs)\"}],[\"$\",\"li\",\"6\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Dimensions:\"}],\" 3000 x 3000 pixels (square, 1:1 ratio)\"]}],[\"$\",\"li\",\"7\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Minimum accepted:\"}],\" most distributors require at least 1400 x 1400px, but 3000 x 3000px is the safe standard\"]}],[\"$\",\"li\",\"8\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"File format:\"}],\" JPEG or PNG\"]}],[\"$\",\"li\",\"9\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Color mode:\"}],\" RGB (not CMYK — that's for print)\"]}],[\"$\",\"li\",\"10\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"File size:\"}],\" typically under 10MB, though this varies slightly by distributor\"]}],[\"$\",\"p\",\"12\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Using anything smaller than 3000px risks your cover looking soft when a platform displays it at a larger size — for example, on an album detail page or a \\\"now playing\\\" full-screen view.\"]}],\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\"]}],\"$L1c\"]}]}],\"$L1d\",\"$L1e\"]}],[\"$L1f\"],\"$L20\"]}],\"isPartial\":\"$@21\",\"staleTime\":\"$22\",\"varyParams\":null},{\"rsc\":\"$L23\",\"isPartial\":\"$@24\",\"staleTime\":\"$22\",\"varyParams\":null},{\"rsc\":\"$L25\",\"isPartial\":\"$@26\",\"staleTime\":\"$22\",\"varyParams\":\"$27\"},{\"rsc\":\"$L28\",\"isPartial\":\"$@29\",\"staleTime\":\"$22\",\"varyParams\":\"$27\"},{\"rsc\":\"$L2a\",\"isPartial\":\"$@2b\",\"staleTime\":\"$22\",\"varyParams\":null}],\"isUpgradeableISRFallback\":false,\"a\":\"$@2c\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@2d\"}\n2e:I[87879,[\"/_next/static/chunks/0h2qsuyze9ds1.js\",\"/_next/static/chunks/3ykrlu0oa3rkw.js\"],\"default\"]\n2f:I[97367,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"OutletBoundary\"]\n30:\"$Sreact.suspense\"\n32:I[97367,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"ViewportBoundary\"]\n33:I[97367,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"MetadataBoundary\"]\n34:I[27201,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"IconMark\"]\n35:I[39756,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"default\"]\n36:I[37457,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"default\"]\n:HL[\"/_next/static/chunks/2b2j6nos8u62l.css\",\"style\"]\n5:[\"$\",\"h2\",\"14\",{\"className\":\"font-anton text-3xl uppercase text-