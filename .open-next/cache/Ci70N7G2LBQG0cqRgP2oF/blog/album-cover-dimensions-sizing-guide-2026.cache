space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"A finished cover getting rejected by a distributor, or looking soft and pixelated on a streaming thumbnail, is almost always a sizing problem — not a quality problem. Here are the exact specs to confirm before a single pixel gets rendered.\"]}],[\"$\",\"hr\",\"2\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}],[\"$\",\"h2\",\"4\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Streaming Platforms (Spotify, Apple Music, and Most DSPs)\"}],[\"$\",\"li\",\"6\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Dimensions:\"}],\" 3000 x 3000 pixels (square, 1:1 ratio)\"]}],[\"$\",\"li\",\"7\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Minimum accepted:\"}],\" most distributors require at least 1400 x 1400px, but 3000 x 3000px is the safe standard\"]}],[\"$\",\"li\",\"8\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"File format:\"}],\" JPEG or PNG\"]}],[\"$\",\"li\",\"9\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Color mode:\"}],\" RGB (not CMYK — that's for print)\"]}],[\"$\",\"li\",\"10\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"File size:\"}],\" typically under 10MB, though this varies slightly by distributor\"]}],[\"$\",\"p\",\"12\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Using anything smaller than 3000px risks your cover looking soft when a platform displays it at a larger size — for example, on an album detail page or a \\\"now playing\\\" full-screen view.\"]}],\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\"]}],\"$L28\"]}]}],\"$L29\",\"$L2a\"]}]\n2b:I[87879,[\"/_next/static/chunks/0h2qsuyze9ds1.js\",\"/_next/static/chunks/3ykrlu0oa3rkw.js\"],\"default\"]\n11:[\"$\",\"h2\",\"14\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Vinyl Packaging\"}]\n12:[\"$\",\"li\",\"16\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Standard 12\\\" sleeve:\"}],\" 12.375 x 12.375 inches (12.5 x 12.5 inches with bleed)\"]}]\n13:[\"$\",\"li\",\"17\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Resolution:\"}],\" 300 DPI minimum at final print size\"]}]\n14:[\"$\",\"li\",\"18\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Color mode:\"}],\" CMYK\"]}]\n15:[\"$\",\"li\",\"19\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Bleed:\"}],\" add 0.125 inches on all sides to avoid white edges after trimming\"]}]\n16:[\"$\",\"p\",\"21\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Vinyl is the one format where getting the file mode wrong (RGB instead of CMYK) causes a visible color shift between what you approved on screen and what prints — always confirm CMYK conversion before sending to a pressing plant.\"]}]\n17:[\"$\",\"h2\",\"23\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"CD Packaging\"}]\n18:[\"$\",\"li\",\"25\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Booklet/front cover:\"}],\" 4.7213 x 4.7213 inches (with bleed)\"]}]\n19:[\"$\",\"li\",\"26\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Resolution:\"}],\" 300 DPI\"]}]\n1a:[\"$\",\"li\",\"27\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Color mode:\"}],\" CMYK\"]}]\n1b:[\"$\",\"h2\",\"29\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Quick Reference Table\"}]\n1c:[\"$\",\"div\",\"table-37\",{\"className\":\"overflow-x-auto my-8 border-2 border-[var(--paper-2)]/30\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-left border-collapse font-mono text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"bg-[var(--paper)] text-[var(--ink)] font-bold\",\"children\":[[\"$\",\"th\",\"0\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"Format\"}],[\"$\",\"th\",\"1\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"Dimensions\"}],[\"$\",\"th\",\"2\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"Resolution\"}],[\"$\",\"th\",\"3\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"Color Mode\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Streaming (Spotify/Apple Music)\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"3000 x 3000px\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"72–300 DPI\"]}],[\"$\",\"td\",\"3\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"RGB\"]}]]}],[\"$\",\"tr\",\"1\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Vinyl 12\\\" sleeve\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"12.5 x 12.5 in (with bleed)\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"300 DPI\"]}],[\"$\",\"td\",\"3\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"CMYK\"]}]]}],[\"$\",\"tr\",\"2\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"CD front cover\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"4.72 x 4.72 in (with bleed)\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"300 DPI\"]}],[\"$\",\"td\",\"3\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"CMYK\"]}]]}],[\"$\",\"tr\",\"3\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Social media thumbnail crop\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"1080 x 1080px\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"72 DPI\"]}],[\"$\",\"td\",\"3\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"RGB\"]}]]}]]}]]}]}]\n1d:[\"$\",\"hr\",\"38\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\n1e:[\"$\",\"h2\",\"40\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Why This Matters Before You Commission, Not After\"}]\n1f:[\"$\",\"p\",\"42\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"The single biggest mistake is deciding on final format \",[\"$\",\"em\",\"1\",{\"className\":\"italic text-[var(--yellow)]\",\"children\":\"after\"}],\" a cover is already finished. Print (CMYK) and digital (RGB) color don't translate 1:1 — a color that looks vivid on screen can shift when converted to CMYK for print. If there's any chance a cover will go to vinyl or CD, say so at the brief stage so the artist can work in the right color mode from the start, rather than converting after the fact.\"]}]\n20:[\"$\",\"p\",\"44\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"A structured commission process — like the one used for \",[\"$\",\"a\",\"1\",{\"href\":\"/#order\",\"className\":\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\",\"children\":\"album, manga, and illustration work here\"}],\" — will typically ask about final format upfront for exactly this reason.\"]}]\n21:[\"$\",\"h2\",\"46\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Manga and Book Cover Specs (For Comparison)\"}]\n22:[\"$\",\"p\",\"48\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Manga and book covers follow a different logic since they're rarely square:\"]}]\n23:[\"$\",\"li\",\"50\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Digital manga/webtoon cover:\"}],\" typically 1600 x 2560px (varies by platform — always check the specific platform's spec sheet)\"]}]\n24:[\"$\",\"li\",\"51\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Print book cover (trade paperback):\"}],\" varies by trim size, but 300 DPI CMYK with bleed is standard across the board\"]}]\n25:[\"$\",\"hr\",\"53\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\n26:[\"$\",\"h2\",\"55\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Final Thoughts\"}]\n27:[\"$\",\"p\",\"57\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Getting dimensions right isn't the creative part of a commission, but it's the part that determines whether the creative work actually holds up across every place it needs to appear — a streaming thumbnail, a printed sleeve, a social post. Confirm the final use case before work starts, and the rest of the process gets a lot simpler.\"]}]\n28:[\"$\",\"div\",null,{\"className\":\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var