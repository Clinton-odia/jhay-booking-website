3840w\" imageSizes=\"(max-width: 1024px) 100vw, 800px\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2b2j6nos8u62l.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3s6nzrbk-8mnv.js\"/><script src=\"/_next/static/chunks/2eg0ks0feyohg.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mkbuudhndal5.js\" async=\"\"></script><script src=\"/_next/static/chunks/2-rtuqsgzmno4.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0d8_zlqdf5yql.js\" async=\"\"></script><script src=\"/_next/static/chunks/0h2qsuyze9ds1.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/3ykrlu0oa3rkw.js\" async=\"\" crossorigin=\"\"></script><title>How to Commission a Custom Album Cover: The Complete 2026 Guide | Jhay Sanyay Studio</title><meta name=\"description\" content=\"Want to hire a custom album cover artist? Here&#x27;s exactly how to commission album, manga, and illustration cover art online — pricing, process, and what to look for.\"/><meta name=\"author\" content=\"Jhay Sanyay\"/><meta name=\"keywords\" content=\"custom album cover artist Nigeria,hire digital cover artist online,manga cover commissions,album art process\"/><meta name=\"creator\" content=\"Jhay Sanyay\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-image-preview:large, max-snippet:-1\"/><meta property=\"og:title\" content=\"How to Commission a Custom Album Cover: The Complete 2026 Guide\"/><meta property=\"og:description\" content=\"Want to hire a custom album cover artist? Here&#x27;s exactly how to commission album, manga, and illustration cover art online — pricing, process, and what to look for.\"/><meta property=\"og:url\" content=\"https://jhaysanyay.com/blog/how-to-commission-custom-album-cover-art\"/><meta property=\"og:image\" content=\"https://jhaysanyay.com/images/cover-art/cover-01.jpg\"/><meta property=\"og:image:alt\" content=\"How to Commission a Custom Album Cover: The Complete 2026 Guide\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2025-01-14T23:00:00.000Z\"/><meta property=\"article:author\" content=\"Jhay Sanyay\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:creator\" content=\"@jhaysanyay\"/><meta name=\"twitter:title\" content=\"How to Commission a Custom Album Cover: The Complete 2026 Guide\"/><meta name=\"twitter:description\" content=\"Want to hire a custom album cover artist? Here&#x27;s exactly how to commission album, manga, and illustration cover art online — pricing, process, and what to look for.\"/><meta name=\"twitter:image\" content=\"https://jhaysanyay.com/images/cover-art/cover-01.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/icon.svg?icon.1hqt-6fdfs6lm.svg\" sizes=\"any\" type=\"image/svg+xml\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col font-sans bg-[var(--ink)] color-[var(--paper)]\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen flex flex-col bg-[var(--ink)]\"><header class=\"sticky top-0 z-40 bg-[var(--ink)] border-b-2 border-[var(--paper-2)] text-[var(--paper)] py-4\"><div class=\"wrap flex flex-wrap justify-between items-center gap-4\"><a class=\"font-anton text-2xl tracking-wider text-[var(--paper)] hover:text-[var(--yellow)] transition-colors relative group\" href=\"/\">JHAY <span class=\"text-[var(--red)] font-bold\">·</span> SANYAY</a><nav class=\"flex items-center gap-4 sm:gap-6 font-mono text-xs text-[var(--paper-2)] tracking-widest uppercase\"><a class=\"text-[var(--paper)] hover:text-[var(--yellow)] font-bold transition-colors\" href=\"/portfolio\">Portfolio</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/blog\">Guides</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/#prices\">Prices</a><a class=\"text-[var(--yellow)] border border-[var(--yellow)] px-3 py-1 hover:bg-[var(--yellow)] hover:text-[var(--ink)] transition-all duration-300 active:scale-95\" href=\"/#order\">Book Ticket</a></nav></div></header><section class=\"bg-[var(--paper)] py-12 border-b-2 border-[var(--ink)] text-[var(--ink)]\"><div class=\"wrap max-w-4xl\"><a class=\"font-mono text-xs text-[var(--red)] uppercase font-bold tracking-wider hover:underline inline-block mb-6\" href=\"/blog\">← Back to All Guides</a><div class=\"flex items-center gap-3 font-mono text-xs text-[var(--muted)] mb-3\"><span class=\"bg-[var(--ink)] text-[var(--paper)] font-bold px-2 py-0.5 uppercase tracking-widest text-[10px]\">Commission Guide</span><span>•</span><span>January 15, 2025</span><span>•</span><span>6 min read</span></div><h1 class=\"font-anton text-4xl sm:text-5xl md:text-6xl uppercase leading-tight text-[var(--ink)] mt-2\">How to Commission a Custom Album Cover: The Complete 2026 Guide</h1><div class=\"flex items-center gap-3 mt-6 pt-4 border-t border-[var(--ink)]/20 font-mono text-xs\"><span class=\"text-[var(--muted)] uppercase\">Written by:</span><span class=\"font-bold text-[var(--ink)]\">Jhay Sanyay</span></div></div></section><article class=\"py-16 bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-3xl space-y-8 font-sans text-lg leading-relaxed text-[var(--paper-2)]/90\"><div class=\"relative aspect-[16/9] w-full border-2 border-[var(--paper-2)]/30 overflow-hidden mb-10 shadow-2xl\"><img alt=\"How to Commission a Custom Album Cover: The Complete 2026 Guide\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 800px\" srcSet=\"/_next/image?url=%2Fimages%2Fcover-art%2Fcover-01.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-01.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-01.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-01.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-01.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-01.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-01.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-01.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fcover-art%2Fcover-01.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"space-y-4\"><p class=\"mb-4 font-sans leading-relaxed\">Your music is finished. The mix is tight, the mastering is done, and the release date is locked in. Then it hits you: you still need cover art, and a stock template just won&#x27;t cut it.</p><p class=\"mb-4 font-sans leading-relaxed\">Commissioning a <strong class=\"font-bold text-[var(--paper)]\">custom album cover artist</strong> is one of the highest-leverage things an independent artist can do before a release. Cover art is often the first thing a listener sees on a playlist thumbnail or Spotify grid — before they&#x27;ve heard a single note. This guide walks through exactly how the process works, what it costs, and how to hire a digital cover artist online without the usual back-and-forth confusion.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Why Custom Cover Art Matters More Than You Think</h2><p class=\"mb-4 font-sans leading-relaxed\">Streaming platforms turned album art into a thumbnail-sized first impression. A generic or AI-generated cover blends into a scroll of a hundred other covers. A custom illustration — one built around your sound, your title, and your visual identity — does the opposite: it stops the scroll.</p><p class=\"mb-4 font-sans leading-relaxed\">This isn&#x27;t unique to music. The same logic applies to <strong class=\"font-bold text-[var(--paper)]\">manga cover commissions</strong> and <strong class=\"font-bold text-[var(--paper)]\">book or webcomic illustration covers</strong> — in every case, the cover is doing marketing work before anyone reads or listens to anything.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 1: Know What You&#x27;re Actually Commissioning</h2><p class=\"mb-4 font-sans leading-relaxed\">&quot;Cover art&quot; isn&#x27;t one thing. Before you reach out to an artist, get clear on which of these you need:</p><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Album/single cover art</strong> — square format, built for streaming platform thumbnails and vinyl/CD packaging</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Manga or comic cover illustration</strong> — character-focused, often with a specific pose, panel composition, or series style to match</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Book cover illustration</strong> — typography-integrated, genre-aware (a thriller cover reads very differently from a fantasy one)</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Concept/character illustration</strong> — for merch, alternate covers, or promotional use</li><p class=\"mb-4 font-sans leading-relaxed\">Knowing this upfront saves you and the artist a round of revisions just to align on scope.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 2: Gather Your References Before You Reach Out</h2><p class=\"mb-4 font-sans leading-relaxed\">Good commissions start with good references, not vague descriptions. Before you contact an artist, put together:</p><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">2–3 existing covers (any genre) whose <em class=\"italic text-[var(--yellow)]\">mood</em> you like — color palette, composition, energy</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Any specific characters, symbols, or objects that must appear</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Your title/artist name exactly as it should appear, plus any font preferences</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Format requirements: square (3000x3000px is standard for streaming), or a specific print dimension</li><p class=\"mb-4 font-sans leading-relaxed\">Artists who work in album covers, manga, and illustration — like Jhay Sanyay, who takes commissions across all three — will usually ask for this anyway, so having it ready speeds up your quote and turnaround time significantly.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 3: Understand Typical Pricing and Turnaround</h2><p class=\"mb-4 font-sans leading-relaxed\">Pricing for custom cover art varies widely based on complexity, but here&#x27;s a realistic range for independent/freelance illustrators (not agencies):</p><div class=\"overflow-x-auto my-8 border-2 border-[var(--paper-2)]/30\"><table class=\"w-full text-left border-collapse font-mono text-sm\"><thead><tr class=\"bg-[var(--paper)] text-[var(--ink)] font-bold\"><th class=\"p-3 border border-[var(--ink)]\">Type</th><th class=\"p-3 border border-[var(--ink)]\">Typical Range</th><th class=\"p-3 border border-[var(--ink)]\">Turnaround</th></tr></thead><tbody><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Simple single/EP cover</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Lower end</td><td class=\"p-3 border border-[var(--paper-2)]/20\">3–7 days</td></tr><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Full album cover with characters/scene</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Mid range</td><td class=\"p-3 border border-[var(--paper-2)]/20\">1–2 weeks</td></tr><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Manga/comic cover with detailed linework</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Mid-to-high range</td><td class=\"p-3 border border-[var(--paper-2)]/20\">1–2 weeks</td></tr><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Rush commission</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Add a rush fee</td><td class=\"p-3 border border-[var(--paper-2)]/20\">24–72 hours</td></tr></tbody></table></div><p class=\"mb-4 font-sans leading-relaxed\">Prices vary by artist and region, so always request a direct quote based on your specific brief rather than assuming a flat rate.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 4: What to Look For When You Hire a Digital Cover Artist Online</h2><p class=\"mb-4 font-sans leading-relaxed\">Not every illustrator with a portfolio is set up to handle commissions smoothly. Before booking, check for:</p><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">A visible, consistent portfolio</strong> — you want to see their range across album covers, manga, or illustration, not just one lucky piece</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">A clear commission process</strong> — a booking form or structured request process (rather than &quot;just DM me&quot;) is a sign the artist runs this professionally</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Defined revision rounds</strong> — know upfront how many revisions are included before extra ones cost more</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Usage rights clarity</strong> — confirm you&#x27;re getting commercial rights to use the art on streaming platforms, merch, or print</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Communication speed</strong> — a quick, clear reply to your first inquiry is often a preview of how the whole project will go</li><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Step 5: The Commission Process, Start to Finish</h2><p class=\"mb-4 font-sans leading-relaxed\">Once you&#x27;ve picked an artist, the process typically looks like this:</p><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Brief submission</strong> — you send your references, title, and requirements (usually through a booking/commission form)</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Quote and timeline</strong> — the artist confirms scope, price, and delivery date</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Sketch/concept phase</strong> — a rough draft or thumbnail sketch for your approval before full rendering</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Line art and color</strong> — the artist builds out the full piece</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Revisions</strong> — you request adjustments within the agreed rounds</li><li class=\"ml-6 list-decimal mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Final delivery</strong> — high-resolution files in the format you need (streaming, print, or both)</li><p class=\"mb-4 font-sans leading-relaxed\">Artists who specialize across <strong class=\"font-bold text-[var(--paper)]\">album covers, manga, and illustration</strong> — such as <a href=\"/ #order\" class=\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\">Jhay&#x27;s Commission Booking Ticket</a> — tend to structure this exact flow, which makes it easier to know what to expect before you commit.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Common Mistakes Artists Make When Commissioning Cover Art</h2><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Being too vague in the brief</strong> — &quot;something cool and dark&quot; gives the artist nothing to work with</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Skipping the reference stage</strong> — references aren&#x27;t a crutch, they&#x27;re how you communicate visual language efficiently</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Not budgeting for revisions</strong> — rushing approval on the sketch stage often means paying for a bigger revision later</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Ignoring file format needs</strong> — confirm you&#x27;re getting both a high-res print file and a platform-optimized thumbnail version</li><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Final Thoughts</h2><p class=\"mb-4 font-sans leading-relaxed\">A strong cover does real work for a release — it&#x27;s often the deciding factor in whether someone clicks play. Whether you&#x27;re releasing an album, launching a manga series, or publishing a book, taking the commission process seriously — clear references, a real brief, and an artist with a consistent portfolio — is what separates cover art that gets noticed from cover art that gets scrolled past.</p><p class=\"mb-4 font-sans leading-relaxed\">If you&#x27;re looking to commission custom album cover art, manga covers, or illustration work, <a href=\"/#order\" class=\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\">Jhay Sanyay Studio</a> takes commissions across all three and runs a structured booking process from brief to final delivery.</p></div><div class=\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--ink)] shadow-[10px_10px_0_var(--red)]\"><div class=\"font-mono text-xs text-[var(--red)] font-bold uppercase tracking-widest mb-1\">Ready to Commission?</div><h3 class=\"font-anton text-3xl uppercase mb-3\">Get Your Custom Artwork Stamped</h3><p class=\"text-sm font-sans text-[var(--muted)] mb-6\">Jhay Sanyay Studio handles custom cover art, manga/comic illustrations, and logo design from brief submission to final delivery. Fill out your job ticket below for a 48-hour quote.</p><a href=\"#order\" class=\"stamp-btn inline-block !py-3 !px-6\">FILL OUT JOB TICKET</a></div></div></article><section id=\"order\" class=\"ticket-build-section py-[72px] bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-[800px] mx-auto\"><div class=\"section-head mb-8 text-center\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"eyebrow font-mono text-xs text-[var(--yellow)] tracking-[0.12em] uppercase mb-[18px] inline-flex items-center gap-[10px] before:content-[&#x27;&#x27;] before:w-5 before:h-[2px] before:bg-[var(--yellow)] after:content-[&#x27;&#x27;] after:w-5 after:h-[2px] after:bg-[var(--yellow)]\">Commission Order Form</div><h2 class=\"text-[clamp(36px,6vw,56px)] font-anton uppercase text-[var(--paper)]\">Create Job Ticket</h2></div><div class=\"ticket relative bg-[var(--ink)] color-[var(--paper)] border-2 border-[var(--paper)] p-6 md:p-12 shadow-[12px_12px_0_var(--red)]\" style=\"opacity:0;transform:scale(0.95)\"><div class=\"notch tl\"></div><div class=\"notch tr\"></div><div class=\"notch bl\"></div><div class=\"notch br\"></div><div class=\"ticket-header flex justify-between items-center border-b-2 border-dashed border-[var(--paper-2)] pb-4 mb-8\"><div class=\"font-anton text-2xl tracking-wider text-[var(--yellow)]\">JHAY SANYAY STUDIO</div><div class=\"font-mono text-xs md:text-sm text-[var(--paper-2)] tracking-widest uppercase\">TICKET NO: <span class=\"font-bold text-[var(--red)]\"></span></div></div><form class=\"space-y-6\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Client / Stage Name <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. Starboy / Divine\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Email or Social Handle <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. @artist / email@domain.com\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Service Category</label><select class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"><option value=\"Single Cover Art\" selected=\"\">Single Cover Art</option><option value=\"EP / Album Art\">EP / Album Art</option><option value=\"Logo / Brand Mark\">Logo / Brand Mark</option><option value=\"Comic Page\">Comic Page</option><option value=\"Motion / Animated Cover\">Motion / Animated Cover</option></select></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Project / Release Title</label><input type=\"text\" placeholder=\"e.g. Midnight Riddim EP\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Target Release / Deadline</label><input type=\"text\" placeholder=\"e.g. Oct 15th / ASAP\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Preferred Contact Method</label><select class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"><option value=\"Email\" selected=\"\">Email</option><option value=\"Instagram DM\">Instagram DM</option><option value=\"WhatsApp\">WhatsApp</option></select></div></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Project Brief &amp; Visual Notes <span class=\"text-[var(--red)]\">*</span></label><textarea required=\"\" rows=\"4\" placeholder=\"Describe your vision, color themes, reference links, mood or key characters...\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"></textarea></div><div class=\"text-center pt-4\"><button type=\"submit\" class=\"stamp-btn\" tabindex=\"0\">STAMP &amp; GENERATE TICKET</button></div></form></div></div></section><footer class=\"bg-[var(--ink)] border-t-2 border-[var(--paper-2)] py-10 color-[var(--paper-2)]\"><div class=\"wrap flex flex-col items-center text-center gap-[10px]\"><div class=\"foot-brand font-anton text-[28px] tracking-[0.04em] text-[var(--paper)]\">JHAY SANYAY</div><div class=\"foot-sub font-mono text-[12px] text-[var(--muted)] uppercase\">Visual Artist &amp; Illustrator · Nigeria</div><div class=\"foot-links flex gap-[20px] font-mono text-[12px] mt-[10px]\"><a class=\"text-[var(--yellow)] hover:underline\" href=\"/portfolio\">Portfolio</a><a class=\"text-[var(--yellow)] hover:underline\" href=\"/blog\">Guides &amp; Blog</a><a href=\"https://linktr.ee/jhaysanyay\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[var(--yellow)] hover:underline\">Linktree ↗</a><a href=\"/#order\" class=\"text-[var(--yellow)] hover:underline\">Job Ticket</a></div><div class=\"text-[12px] text-[var(--yellow)] mt-[20px] tracking-wider uppercase\">designed by <a href=\"https://www.instagram.com/buildwithclinton/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[var(--paper)] hover:text-[var(--yellow)] hover:underline transition-colors\">buildwithclinton ↗</a></div></div></footer></main><!--$--><!--/$--><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n5:I[97367,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"OutletBoundary\\\"]\\n6:\\\"$Sreact.suspense\\\"\\n9:I[97367,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"ViewportBoundary\\\"]\\nb:I[97367,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"MetadataBoundary\\\"]\\nd:I[68027,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/2b2j6nos8u62l.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/7ddd198311ba7843-s.p.3kq6k02b2ysv1.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/8d05cfa5faa8406c-s.p.1s123piy9_v1m.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/9e9f04e3c37952ab-s.p.0pan85mumqyf3.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/dc0d9adbac686440-s.p.3cik_s2si-ft-.woff2\\\