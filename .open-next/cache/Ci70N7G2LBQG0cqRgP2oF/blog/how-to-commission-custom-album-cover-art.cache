i\",\"21\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Concept/character illustration\"}],\" — for merch, alternate covers, or promotional use\"]}]\nd:[\"$\",\"p\",\"23\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Knowing this upfront saves you and the artist a round of revisions just to align on scope.\"]}]\ne:[\"$\",\"hr\",\"25\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\nf:[\"$\",\"h2\",\"27\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Step 2: Gather Your References Before You Reach Out\"}]\n10:[\"$\",\"p\",\"29\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Good commissions start with good references, not vague descriptions. Before you contact an artist, put together:\"]}]\n11:[\"$\",\"li\",\"31\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"2–3 existing covers (any genre) whose \",[\"$\",\"em\",\"1\",{\"className\":\"italic text-[var(--yellow)]\",\"children\":\"mood\"}],\" you like — color palette, composition, energy\"]}]\n12:[\"$\",\"li\",\"32\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"Any specific characters, symbols, or objects that must appear\"]}]\n13:[\"$\",\"li\",\"33\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"Your title/artist name exactly as it should appear, plus any font preferences\"]}]\n14:[\"$\",\"li\",\"34\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"Format requirements: square (3000x3000px is standard for streaming), or a specific print dimension\"]}]\n15:[\"$\",\"p\",\"36\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Artists who work in album covers, manga, and illustration — like Jhay Sanyay, who takes commissions across all three — will usually ask for this anyway, so having it ready speeds up your quote and turnaround time significantly.\"]}]\n16:[\"$\",\"hr\",\"38\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\n17:[\"$\",\"h2\",\"40\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Step 3: Understand Typical Pricing and Turnaround\"}]\n18:[\"$\",\"p\",\"42\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Pricing for custom cover art varies widely based on complexity, but here's a realistic range for independent/freelance illustrators (not agencies):\"]}]\n19:[\"$\",\"div\",\"table-50\",{\"className\":\"overflow-x-auto my-8 border-2 border-[var(--paper-2)]/30\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-left border-collapse font-mono text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"bg-[var(--paper)] text-[var(--ink)] font-bold\",\"children\":[[\"$\",\"th\",\"0\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"Type\"}],[\"$\",\"th\",\"1\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"Typical Range\"}],[\"$\",\"th\",\"2\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"Turnaround\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Simple single/EP cover\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"Lower end\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"3–7 days\"]}]]}],[\"