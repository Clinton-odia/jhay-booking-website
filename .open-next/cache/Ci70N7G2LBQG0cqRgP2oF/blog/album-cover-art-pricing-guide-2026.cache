" imageSizes=\"(max-width: 1024px) 100vw, 800px\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2b2j6nos8u62l.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3s6nzrbk-8mnv.js\"/><script src=\"/_next/static/chunks/2eg0ks0feyohg.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mkbuudhndal5.js\" async=\"\"></script><script src=\"/_next/static/chunks/2-rtuqsgzmno4.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0d8_zlqdf5yql.js\" async=\"\"></script><script src=\"/_next/static/chunks/0h2qsuyze9ds1.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/3ykrlu0oa3rkw.js\" async=\"\" crossorigin=\"\"></script><title>Custom Album Cover Art Pricing: What to Expect in 2026 | Jhay Sanyay Studio</title><meta name=\"description\" content=\"A real breakdown of what custom album, manga, and illustration cover art actually costs — what drives the price up or down, and how to budget for it.\"/><meta name=\"author\" content=\"Jhay Sanyay\"/><meta name=\"keywords\" content=\"how much does album cover art cost,custom album cover pricing,digital cover artist rates\"/><meta name=\"creator\" content=\"Jhay Sanyay\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-image-preview:large, max-snippet:-1\"/><meta property=\"og:title\" content=\"Custom Album Cover Art Pricing: What to Expect in 2026\"/><meta property=\"og:description\" content=\"A real breakdown of what custom album, manga, and illustration cover art actually costs — what drives the price up or down, and how to budget for it.\"/><meta property=\"og:url\" content=\"https://jhaysanyay.com/blog/album-cover-art-pricing-guide-2026\"/><meta property=\"og:image\" content=\"https://jhaysanyay.com/images/cover-art/cover-03.jpg\"/><meta property=\"og:image:alt\" content=\"How Much Does Custom Album Cover Art Actually Cost in 2026?\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2025-04-01T23:00:00.000Z\"/><meta property=\"article:author\" content=\"Jhay Sanyay\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:creator\" content=\"@jhaysanyay\"/><meta name=\"twitter:title\" content=\"Custom Album Cover Art Pricing: What to Expect in 2026\"/><meta name=\"twitter:description\" content=\"A real breakdown of what custom album, manga, and illustration cover art actually costs — what drives the price up or down, and how to budget for it.\"/><meta name=\"twitter:image\" content=\"https://jhaysanyay.com/images/cover-art/cover-03.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/icon.svg?icon.1hqt-6fdfs6lm.svg\" sizes=\"any\" type=\"image/svg+xml\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col font-sans bg-[var(--ink)] color-[var(--paper)]\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen flex flex-col bg-[var(--ink)]\"><header class=\"sticky top-0 z-40 bg-[var(--ink)] border-b-2 border-[var(--paper-2)] text-[var(--paper)] py-4\"><div class=\"wrap flex flex-wrap justify-between items-center gap-4\"><a class=\"font-anton text-2xl tracking-wider text-[var(--paper)] hover:text-[var(--yellow)] transition-colors relative group\" href=\"/\">JHAY <span class=\"text-[var(--red)] font-bold\">·</span> SANYAY</a><nav class=\"flex items-center gap-4 sm:gap-6 font-mono text-xs text-[var(--paper-2)] tracking-widest uppercase\"><a class=\"text-[var(--paper)] hover:text-[var(--yellow)] font-bold transition-colors\" href=\"/portfolio\">Portfolio</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/blog\">Guides</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/#prices\">Prices</a><a class=\"text-[var(--yellow)] border border-[var(--yellow)] px-3 py-1 hover:bg-[var(--yellow)] hover:text-[var(--ink)] transition-all duration-300 active:scale-95\" href=\"/#order\">Book Ticket</a></nav></div></header><section class=\"bg-[var(--paper)] py-12 border-b-2 border-[var(--ink)] text-[var(--ink)]\"><div class=\"wrap max-w-4xl\"><a class=\"font-mono text-xs text-[var(--red)] uppercase font-bold tracking-wider hover:underline inline-block mb-6\" href=\"/blog\">← Back to All Guides</a><div class=\"flex items-center gap-3 font-mono text-xs text-[var(--muted)] mb-3\"><span class=\"bg-[var(--ink)] text-[var(--paper)] font-bold px-2 py-0.5 uppercase tracking-widest text-[10px]\">Pricing Guide</span><span>•</span><span>April 2, 2025</span><span>•</span><span>6 min read</span></div><h1 class=\"font-anton text-4xl sm:text-5xl md:text-6xl uppercase leading-tight text-[var(--ink)] mt-2\">How Much Does Custom Album Cover Art Actually Cost in 2026?</h1><div class=\"flex items-center gap-3 mt-6 pt-4 border-t border-[var(--ink)]/20 font-mono text-xs\"><span class=\"text-[var(--muted)] uppercase\">Written by:</span><span class=\"font-bold text-[var(--ink)]\">Jhay Sanyay</span></div></div></section><article class=\"py-16 bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-3xl space-y-8 font-sans text-lg leading-relaxed text-[var(--paper-2)]/90\"><div class=\"relative aspect-[16/9] w-full border-2 border-[var(--paper-2)]/30 overflow-hidden mb-10 shadow-2xl\"><img alt=\"How Much Does Custom Album Cover Art Actually Cost in 2026?\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 800px\" srcSet=\"/_next/image?url=%2Fimages%2Fcover-art%2Fcover-03.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-03.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-03.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-03.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-03.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-03.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-03.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-03.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fcover-art%2Fcover-03.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"space-y-4\"><p class=\"mb-4 font-sans leading-relaxed\">Search &quot;custom album cover price&quot; and you&#x27;ll get numbers ranging from almost nothing to genuinely expensive, with no explanation for the gap. That&#x27;s because cover art pricing isn&#x27;t really about a flat rate — it&#x27;s about a handful of specific factors that change the amount of actual work involved.</p><p class=\"mb-4 font-sans leading-relaxed\">Here&#x27;s what those factors are, so you can budget realistically before you reach out to an artist.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Why Cover Art Pricing Varies So Much</h2><p class=\"mb-4 font-sans leading-relaxed\">Two &quot;album covers&quot; can require wildly different amounts of work. A single stylized character on a flat background is a different job than a full scene with multiple characters, detailed lighting, and print-ready resolution. Pricing follows the work, not the category label.</p><p class=\"mb-4 font-sans leading-relaxed\">The factors that actually move the number:</p><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Number of subjects</strong> — each additional character or focal element adds meaningful time</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Background complexity</strong> — flat/minimal vs. a fully rendered environment</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Level of detail and rendering</strong> — flat color vs. full shading, lighting, and texture work</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Usage rights</strong> — personal use vs. commercial release/distribution rights</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Turnaround time</strong> — standard timeline vs. rush delivery</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Revisions included</strong> — more included rounds generally means a higher base price</li><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">A Realistic Pricing Framework</h2><p class=\"mb-4 font-sans leading-relaxed\">Rather than quoting flat numbers that go stale fast, here&#x27;s how to think about where a project lands:</p><div class=\"overflow-x-auto my-8 border-2 border-[var(--paper-2)]/30\"><table class=\"w-full text-left border-collapse font-mono text-sm\"><thead><tr class=\"bg-[var(--paper)] text-[var(--ink)] font-bold\"><th class=\"p-3 border border-[var(--ink)]\">Complexity Tier</th><th class=\"p-3 border border-[var(--ink)]\">What It Includes</th><th class=\"p-3 border border-[var(--ink)]\">Turnaround</th></tr></thead><tbody><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Simple</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Single subject, minimal/flat background, standard color</td><td class=\"p-3 border border-[var(--paper-2)]/20\">3–7 days</td></tr><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Standard</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Full scene, one main subject, moderate detail and rendering</td><td class=\"p-3 border border-[var(--paper-2)]/20\">1–2 weeks</td></tr><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Complex</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Multiple subjects, detailed background, full rendering/lighting</td><td class=\"p-3 border border-[var(--paper-2)]/20\">2–3 weeks</td></tr><tr class=\"border-b border-[var(--paper-2)]/20\"><td class=\"p-3 border border-[var(--paper-2)]/20\"><strong class=\"font-bold text-[var(--paper)]\">Rush (any tier)</strong></td><td class=\"p-3 border border-[var(--paper-2)]/20\">Same scope, compressed timeline</td><td class=\"p-3 border border-[var(--paper-2)]/20\">24–72 hours, rush fee applies</td></tr></tbody></table></div><p class=\"mb-4 font-sans leading-relaxed\">Manga and comic covers tend to sit at the standard-to-complex end by default, since character accuracy and composition work is usually non-negotiable for that format.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">What&#x27;s Usually Included vs. What Costs Extra</h2><p class=\"mb-4 font-sans leading-relaxed\">Most structured commission processes include a set number of revision rounds and a standard license (personal or limited promotional use) in the base price. Where extra cost typically comes in:</p><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Commercial/full distribution licensing beyond the base agreement</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Revisions beyond the included rounds</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Rush delivery</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\">Print-specific file prep (bleed, CMYK conversion, physical dimensions)</li><p class=\"mb-4 font-sans leading-relaxed\">Asking about these upfront — before you&#x27;re mid-project — avoids surprise costs later.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Why the Cheapest Option Isn&#x27;t Always the Best Value</h2><p class=\"mb-4 font-sans leading-relaxed\">A very low price usually means one of a few things: a simpler process with fewer revision rounds, a less experienced artist still building a portfolio, or unclear licensing that could cause problems later if the release does well. None of those are automatically dealbreakers — but they&#x27;re worth knowing about upfront, not discovering after the fact.</p><p class=\"mb-4 font-sans leading-relaxed\">The better question isn&#x27;t &quot;what&#x27;s the cheapest option&quot; but &quot;what does this price actually include&quot; — revisions, rights, and turnaround all belong in that comparison, not just the number itself.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Getting an Accurate Quote</h2><p class=\"mb-4 font-sans leading-relaxed\">The fastest way to get a real number instead of a guess is to send a specific brief: subject count, reference images, intended use, and desired turnaround. A structured commission process — like the one used for <a href=\"/#order\" class=\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\">album, manga, and illustration commissions here</a> — will typically return a quote based on that brief rather than a generic price list, which is the only way to get a number that actually reflects your project.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Final Thoughts</h2><p class=\"mb-4 font-sans leading-relaxed\">Cover art pricing looks confusing from the outside because it&#x27;s genuinely tied to project scope, not a fixed menu. Once you know the actual levers — subject count, detail level, rights, and turnaround — you can budget accurately and have a much more useful conversation with whoever you end up commissioning.</p></div><div class=\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--ink)] shadow-[10px_10px_0_var(--red)]\"><div class=\"font-mono text-xs text-[var(--red)] font-bold uppercase tracking-widest mb-1\">Ready to Commission?</div><h3 class=\"font-anton text-3xl uppercase mb-3\">Get Your Custom Artwork Stamped</h3><p class=\"text-sm font-sans text-[var(--muted)] mb-6\">Jhay Sanyay Studio handles custom cover art, manga/comic illustrations, and logo design from brief submission to final delivery. Fill out your job ticket below for a 48-hour quote.</p><a href=\"#order\" class=\"stamp-btn inline-block !py-3 !px-6\">FILL OUT JOB TICKET</a></div></div></article><section id=\"order\" class=\"ticket-build-section py-[72px] bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-[800px] mx-auto\"><div class=\"section-head mb-8 text-center\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"eyebrow font-mono text-xs text-[var(--yellow)] tracking-[0.12em] uppercase mb-[18px] inline-flex items-center gap-[10px] before:content-[&#x27;&#x27;] before:w-5 before:h-[2px] before:bg-[var(--yellow)] after:content-[&#x27;&#x27;] after:w-5 after:h-[2px] after:bg-[var(--yellow)]\">Commission Order Form</div><h2 class=\"text-[clamp(36px,6vw,56px)] font-anton uppercase text-[var(--paper)]\">Create Job Ticket</h2></div><div class=\"ticket relative bg-[var(--ink)] color-[var(--paper)] border-2 border-[var(--paper)] p-6 md:p-12 shadow-[12px_12px_0_var(--red)]\" style=\"opacity:0;transform:scale(0.95)\"><div class=\"notch tl\"></div><div class=\"notch tr\"></div><div class=\"notch bl\"></div><div class=\"notch br\"></div><div class=\"ticket-header flex justify-between items-center border-b-2 border-dashed border-[var(--paper-2)] pb-4 mb-8\"><div class=\"font-anton text-2xl tracking-wider text-[var(--yellow)]\">JHAY SANYAY STUDIO</div><div class=\"font-mono text-xs md:text-sm text-[var(--paper-2)] tracking-widest uppercase\">TICKET NO: <span class=\"font-bold text-[var(--red)]\"></span></div></div><form class=\"space-y-6\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Client / Stage Name <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. Starboy / Divine\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Email or Social Handle <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. @artist / email@domain.com\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Service Category</label><select class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"><option value=\"Single Cover Art\" selected=\"\">Single Cover Art</option><option value=\"EP / Album Art\">EP / Album Art</option><option value=\"Logo / Brand Mark\">Logo / Brand Mark</option><option value=\"Comic Page\">Comic Page</option><option value=\"Motion / Animated Cover\">Motion / Animated Cover</option></select></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Project / Release Title</label><input type=\"text\" placeholder=\"e.g. Midnight Riddim EP\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Target Release / Deadline</label><input type=\"text\" placeholder=\"e.g. Oct 15th / ASAP\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Preferred Contact Method</label><select class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"><option value=\"Email\" selected=\"\">Email</option><option value=\"Instagram DM\">Instagram DM</option><option value=\"WhatsApp\">WhatsApp</option></select></div></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Project Brief &amp; Visual Notes <span class=\"text-[var(--red)]\">*</span></label><textarea required=\"\" rows=\"4\" placeholder=\"Describe your vision, color themes, reference links, mood or key characters...\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"></textarea></div><div class=\"text-center pt-4\"><button type=\"submit\" class=\"stamp-btn\" tabindex=\"0\">STAMP &amp; GENERATE TICKET</button></div></form></div></div></section><footer class=\"bg-[var(--ink)] border-t-2 border-[var(--paper-2)] py-10 color-[var(--paper-2)]\"><div class=\"wrap flex flex-col items-center text-center gap-[10px]\"><div class=\"foot-brand font-anton text-[28px] tracking-[0.04em] text-[var(--paper)]\">JHAY SANYAY</div><div class=\"foot-sub font-mono text-[12px] text-[var(--muted)] uppercase\">Visual Artist &amp; Illustrator · Nigeria</div><div class=\"foot-links flex gap-[20px] font-mono text-[12px] mt-[10px]\"><a class=\"text-[var(--yellow)] hover:underline\" href=\"/portfolio\">Portfolio</a><a class=\"text-[var(--yellow)] hover:underline\" href=\"/blog\">Guides &amp; Blog</a><a href=\"https://linktr.ee/jhaysanyay\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[var(--yellow)] hover:underline\">Linktree ↗</a><a href=\"/#order\" class=\"text-[var(--yellow)] hover:underline\">Job Ticket</a></div><div class=\"text-[12px] text-[var(--yellow)] mt-[20px] tracking-wider uppercase\">designed by <a href=\"https://www.instagram.com/buildwithclinton/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[var(--paper)] hover:text-[var(--yellow)] hover:underline transition-colors\">buildwithclinton ↗</a></div></div></footer></main><!--$--><!--/$--><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragm