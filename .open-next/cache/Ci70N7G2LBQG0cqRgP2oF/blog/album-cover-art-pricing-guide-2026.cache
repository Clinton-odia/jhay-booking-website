\",\"$1\",\"c\",{\"children\":[[\"$\",\"main\",null,{\"className\":\"min-h-screen flex flex-col bg-[var(--ink)]\",\"children\":[[\"$\",\"$L2\",null,{}],[\"$\",\"section\",null,{\"className\":\"bg-[var(--paper)] py-12 border-b-2 border-[var(--ink)] text-[var(--ink)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-4xl\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/blog\",\"className\":\"font-mono text-xs text-[var(--red)] uppercase font-bold tracking-wider hover:underline inline-block mb-6\",\"children\":\"← Back to All Guides\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-xs text-[var(--muted)] mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"bg-[var(--ink)] text-[var(--paper)] font-bold px-2 py-0.5 uppercase tracking-widest text-[10px]\",\"children\":\"Pricing Guide\"}],[\"$\",\"span\",null,{\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"April 2, 2025\"}],[\"$\",\"span\",null,{\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"6 min read\"}]]}],[\"$\",\"h1\",null,{\"className\":\"font-anton text-4xl sm:text-5xl md:text-6xl uppercase leading-tight text-[var(--ink)] mt-2\",\"children\":\"How Much Does Custom Album Cover Art Actually Cost in 2026?\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mt-6 pt-4 border-t border-[var(--ink)]/20 font-mono text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[var(--muted)] uppercase\",\"children\":\"Written by:\"}],[\"$\",\"span\",null,{\"className\":\"font-bold text-[var(--ink)]\",\"children\":\"Jhay Sanyay\"}]]}]]}]}],[\"$\",\"article\",null,{\"className\":\"py-16 bg-[var(--ink)] text-[var(--paper)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-3xl space-y-8 font-sans text-lg leading-relaxed text-[var(--paper-2)]/90\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative aspect-[16/9] w-full border-2 border-[var(--paper-2)]/30 overflow-hidden mb-10 shadow-2xl\",\"children\":[\"$\",\"$L4\",null,{\"src\":\"/images/cover-art/cover-03.jpg\",\"alt\":\"How Much Does Custom Album Cover Art Actually Cost in 2026?\",\"fill\":true,\"sizes\":\"(max-width: 1024px) 100vw, 800px\",\"className\":\"object-cover\",\"priority\":true}]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Search \\\"custom album cover price\\\" and you'll get numbers ranging from almost nothing to genuinely expensive, with no explanation for the gap. That's because cover art pricing isn't really about a flat rate — it's about a handful of specific factors that change the amount of actual work involved.\"]}],[\"$\",\"p\",\"2\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Here's what those factors are, so you can budget realistically before you reach out to an artist.\"]}],[\"$\",\"hr\",\"4\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}],[\"$\",\"h2\",\"6\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Why Cover Art Pricing Varies So Much\"}],[\"$\",\"p\",\"8\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Two \\\"album covers\\\" can require wildly different amounts of work. A single stylized character on a flat background is a different job than a full scene with multiple characters, detailed lighting, and print-ready resolution. Pricing follows the work, not the category label.\"]}],[\"$\",\"p\",\"10\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"The factors that actually move the number:\"]}],[\"$\",\"li\",\"12\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Number of subjects\"}],\" — each additional character or focal element adds meaningful time\"]}],[\"$\",\"li\",\"13\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Background complexity\"}],\" — flat/minimal vs. a fully rendered environment\"]}],\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\"]}],\"$L20\"]}]}],\"$L21\",\"$L22\"]}],[\"$L23\"],\"$L24\"]}],\"isPartial\":\"$@25\",\"staleTime\":\"$26\",\"varyParams\":null},{\"rsc\":\"$L27\",\"isPartial\":\"$@28\",\"staleTime\":\"$26\",\"varyParams\":null},{\"rsc\":\"$L29\",\"isPartial\":\"$@2a\",\"staleTime\":\"$26\",\"varyParams\":\"$2b\"},{\"rsc\":\"$L2c\",\"isPartial\":\"$@2d\",\"staleTime\":\"$26\",\"varyParams\":\"$2b\"},{\"rsc\":\"$L2e\",\"isPartial\":\"$@2f\",\"staleTime\":\"$26\",\"varyParams\":null}],\"isUpgradeableISRFallback\":false,\"a\":\"$@30\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@31\"}\n32:I[87879,[\"/_next/static/chunks/0h2qsuyze9ds1.js\",\"/_next/static/chunks/3ykrlu0oa3rkw.js\"],\"default\"]\n33:I[97367,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"OutletBoundary\"]\n34:\"$Sreact.suspense\"\n36:I[97367,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"ViewportBoundary\"]\n37:I[97367,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"MetadataBoundary\"]\n38:I[27201,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"IconMark\"]\n39:I[39756,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"default\"]\n3a:I[37457,[\"/_next/static/chunks/0h2qsuyze9ds1.js\"],\"default\"]\n:HL[\"/_next/static/chunks/2b2j6nos8u62l.css\",\"style\"]\n5:[\"$\",\"li\",\"14\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Level of detail and rendering\"}],\" — flat color vs. full shading, lighting, and texture work\"]}]\n6:[\"$\",\"li\",\"15\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Usage rights\"}],\" — personal use vs. commercial release/distribution rights\"]}]\n7:[\"$\",\"li\",\"16\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Turnaround time\"}],\" — standard timeline vs. rush delivery\"]}]\n8:[\"$\",\"li\",\"17\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Revisions included\"}],\" — more included rounds generally means a higher base price\"]}]\n9:[\"$\",\"hr\",\"19\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\na:[\"$\",\"h2\",\"21\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"A Realistic Pricing Framework\"}]\nb:[\"$\",\"p\",\"23\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Rather than quoting flat numbers that go stale fast, here's how to think about where a project lands:\"]}]\nc:[\"$\",\"div\",\"table-31\",{\"className\":\"overflow-x-auto my-8 border-2 border-[var(--paper-2)]/30\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full text-left border-collapse font-mono text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"bg-[var(--paper)] text-[var(--ink)] font-bold\",\"children\":[[\"$\",\"th\",\"0\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"Complexity Tier\"}],[\"$\",\"th\",\"1\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"What It Includes\"}],[\"$\",\"th\",\"2\",{\"className\":\"p-3 border border-[var(--ink)]\",\"children\":\"Turnaround\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"0\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Simple\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"Single subject, minimal/flat background, standard color\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"3–7 days\"]}]]}],[\"$\",\"tr\",\"1\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Standard\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"Full scene, one main subject, moderate detail and rendering\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"1–2 weeks\"]}]]}],[\"$\",\"tr\",\"2\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Complex\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"Multiple subjects, detailed background, full rendering/lighting\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"2–3 weeks\"]}]]}],[\"$\",\"tr\",\"3\",{\"className\":\"border-b border-[var(--paper-2)]/20\",\"children\":[[\"$\",\"td\",\"0\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Rush (any tier)\"}],\"\"]}],[\"$\",\"td\",\"1\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"Same scope, compressed timeline\"]}],[\"$\",\"td\",\"2\",{\"className\":\"p-3 border border-[var(--paper-2)]/20\",\"children\":[\"24–72 hours, rush fee applies\"]}]]}]]}]]}]}]\nd:[\"$\",\"p\",\"32\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Manga and comic covers tend to sit at the standard-to-complex end by default, since character accuracy and composition work is usually non-negotiable for that format.\"]}]\ne:[\"$\",\"hr\",\"34\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\nf:[\"$\",\"h2\",\"36\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"What's Usually Included vs. What Costs Extra\"}]\n10:[\"$\",\"p\",\"38\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Most structured commission processes include a set number of revision rounds and a standard license (personal or limited promotional use) in the base price. Where extra cost typically comes in:\"]}]\n11:[\"$\",\"li\",\"40\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"Commercial/full distribution licensing beyond the base agreement\"]}]\n12:[\"$\",\"li\",\"41\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"Revisions beyond the included rounds\"]}]\n13:[\"$\",\"li\",\"42\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"Rush delivery\"]}]\n14:[\"$\",\"li\",\"43\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"Print-specific file prep (bleed, CMYK conversion, physical dimensions)\"]}]\n15:[\"$\",\"p\",\"45\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Asking about these upfront — before you're mid-project — avoids surprise costs later.\"]}]\n16:[\"$\",\"hr\",\"47\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\n17:[\"$\",\"h2\",\"49\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Why the Cheapest Option Isn't Always the Best Value\"}]\n18:[\"$\",\"p\",\"51\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"A very low price usually means one of a few things: a simpler process with fewer revision rounds, a less experienced artist still building a portfolio, or unclear licensing that could cause problems later if the release does well. None of those are automatically dealbreakers — but they're worth knowing about upfront, not discovering after the fact.\"]}]\n19:[\"$\",\"p\",\"53\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"The better question isn't \\\"what's the cheapest option\\\" but \\\"what does this price actually include\\\" — revisions, rights, and turnaround all belong in that comparison, not just the number itself.\"]}]\n1a:[\"$\",\"hr\",\"55\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\n1b:[\"$\",\"h2\",\"57\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Getting an Accurate Quote\"}]\n1c:[\"$\",\"p\",\"59\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"The fastest way to get a real number instead of a guess is to send a specific brief: subject count, reference images, intended use, and desired turnaround. A structured commission process — like the one used for \",[\"$\",\"a\",\"1\",{\"href\":\"/#order\",\"className\":\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\",\"children\":\"album, manga, and illustration commissions here\"}],\" — will typically return a quote based on that brief rather than a generic price list, which is the only way to get a number that actually reflects your project.\"]}]\n1d:[\"$\",\"hr\",\"61\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\n1e:[\"$\",\"h2\",\"63\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Final Thoughts\"}]\n1f:[\"$\",\"p\",\"65\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Cover art pricing looks confusing from the outside because it's genuinely tied to project scope, not a fixed menu. Once you know the actual levers — subject count, detail level, rights, and turnaround — you can budget accurately and have a much more useful conversation with whoever you end up commissioning.\"]}]\n20:[\"$\",\"div\",null,{\"className\":\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--ink)] shadow-[10px_10px_0_var(--red)]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-mono text-xs text-[var(--red)] font-bold uppercase tracking-widest mb-1\",\"children\":\"Ready to Commission?\"}],[\"$\",\"h3\",null,{\"className\":\"font-anton text-3xl uppercase mb-3\",\"children\":\"Get Your Custom Artwork Stamped\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-sans text-[var(--muted)] mb-6\",\"children\":\"Jhay Sanyay Studio handles custom cover art, manga/comic illustrations, and logo design from brief submission to final delivery. Fill out your job ticket below for a 48-hour quote.\"}],[\"$\",\"a\",null,{\"href\":\"#order\",\"className\":\"stamp-btn inline-block !py-3 !px-6\",\"children\":\"FILL OUT JOB TICKET\"}]]}]\n21:[\"$\",\"$L32\",null,{}]\n22:[\"$\",\"footer\",null,{\"className\":\"bg-[var(--ink)] border-t-2 border-[var(--paper-2)] py-10 color-[var(--paper-2)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap flex flex-col items-center text-center gap-[10px]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"foot-brand font-anton text-[28px] tracking-[0.04em] text-[var(--paper)]\",\"children\