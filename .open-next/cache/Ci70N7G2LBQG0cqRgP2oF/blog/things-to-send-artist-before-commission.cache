840w\" imageSizes=\"(max-width: 1024px) 100vw, 800px\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2b2j6nos8u62l.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3s6nzrbk-8mnv.js\"/><script src=\"/_next/static/chunks/2eg0ks0feyohg.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mkbuudhndal5.js\" async=\"\"></script><script src=\"/_next/static/chunks/2-rtuqsgzmno4.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0d8_zlqdf5yql.js\" async=\"\"></script><script src=\"/_next/static/chunks/0h2qsuyze9ds1.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/3ykrlu0oa3rkw.js\" async=\"\" crossorigin=\"\"></script><title>10 Things to Send Your Artist Before Commissioning Cover Art | Jhay Sanyay Studio</title><meta name=\"description\" content=\"A practical checklist of everything to prepare before you commission album, manga, or illustration cover art — so your first message gets you a fast, accurate quote.\"/><meta name=\"author\" content=\"Jhay Sanyay\"/><meta name=\"keywords\" content=\"commission brief checklist,what to send artist before commission,how to brief a cover artist\"/><meta name=\"creator\" content=\"Jhay Sanyay\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-image-preview:large, max-snippet:-1\"/><meta property=\"og:title\" content=\"10 Things to Send Your Artist Before Commissioning Cover Art\"/><meta property=\"og:description\" content=\"A practical checklist of everything to prepare before you commission album, manga, or illustration cover art — so your first message gets you a fast, accurate quote.\"/><meta property=\"og:url\" content=\"https://jhaysanyay.com/blog/things-to-send-artist-before-commission\"/><meta property=\"og:image\" content=\"https://jhaysanyay.com/images/cover-art/cover-04.jpg\"/><meta property=\"og:image:alt\" content=\"10 Things to Send Your Artist Before You Commission Cover Art\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2025-05-13T23:00:00.000Z\"/><meta property=\"article:author\" content=\"Jhay Sanyay\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:creator\" content=\"@jhaysanyay\"/><meta name=\"twitter:title\" content=\"10 Things to Send Your Artist Before Commissioning Cover Art\"/><meta name=\"twitter:description\" content=\"A practical checklist of everything to prepare before you commission album, manga, or illustration cover art — so your first message gets you a fast, accurate quote.\"/><meta name=\"twitter:image\" content=\"https://jhaysanyay.com/images/cover-art/cover-04.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/icon.svg?icon.1hqt-6fdfs6lm.svg\" sizes=\"any\" type=\"image/svg+xml\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col font-sans bg-[var(--ink)] color-[var(--paper)]\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen flex flex-col bg-[var(--ink)]\"><header class=\"sticky top-0 z-40 bg-[var(--ink)] border-b-2 border-[var(--paper-2)] text-[var(--paper)] py-4\"><div class=\"wrap flex flex-wrap justify-between items-center gap-4\"><a class=\"font-anton text-2xl tracking-wider text-[var(--paper)] hover:text-[var(--yellow)] transition-colors relative group\" href=\"/\">JHAY <span class=\"text-[var(--red)] font-bold\">·</span> SANYAY</a><nav class=\"flex items-center gap-4 sm:gap-6 font-mono text-xs text-[var(--paper-2)] tracking-widest uppercase\"><a class=\"text-[var(--paper)] hover:text-[var(--yellow)] font-bold transition-colors\" href=\"/portfolio\">Portfolio</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/blog\">Guides</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/#prices\">Prices</a><a class=\"text-[var(--yellow)] border border-[var(--yellow)] px-3 py-1 hover:bg-[var(--yellow)] hover:text-[var(--ink)] transition-all duration-300 active:scale-95\" href=\"/#order\">Book Ticket</a></nav></div></header><section class=\"bg-[var(--paper)] py-12 border-b-2 border-[var(--ink)] text-[var(--ink)]\"><div class=\"wrap max-w-4xl\"><a class=\"font-mono text-xs text-[var(--red)] uppercase font-bold tracking-wider hover:underline inline-block mb-6\" href=\"/blog\">← Back to All Guides</a><div class=\"flex items-center gap-3 font-mono text-xs text-[var(--muted)] mb-3\"><span class=\"bg-[var(--ink)] text-[var(--paper)] font-bold px-2 py-0.5 uppercase tracking-widest text-[10px]\">Commission Checklist</span><span>•</span><span>May 14, 2025</span><span>•</span><span>5 min read</span></div><h1 class=\"font-anton text-4xl sm:text-5xl md:text-6xl uppercase leading-tight text-[var(--ink)] mt-2\">10 Things to Send Your Artist Before You Commission Cover Art</h1><div class=\"flex items-center gap-3 mt-6 pt-4 border-t border-[var(--ink)]/20 font-mono text-xs\"><span class=\"text-[var(--muted)] uppercase\">Written by:</span><span class=\"font-bold text-[var(--ink)]\">Jhay Sanyay</span></div></div></section><article class=\"py-16 bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-3xl space-y-8 font-sans text-lg leading-relaxed text-[var(--paper-2)]/90\"><div class=\"relative aspect-[16/9] w-full border-2 border-[var(--paper-2)]/30 overflow-hidden mb-10 shadow-2xl\"><img alt=\"10 Things to Send Your Artist Before You Commission Cover Art\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 800px\" srcSet=\"/_next/image?url=%2Fimages%2Fcover-art%2Fcover-04.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-04.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-04.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-04.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-04.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-04.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-04.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fcover-art%2Fcover-04.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fcover-art%2Fcover-04.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"space-y-4\"><p class=\"mb-4 font-sans leading-relaxed\">Most commission delays don&#x27;t come from the artist — they come from a brief that has to be filled in piece by piece over several messages. The fix is simple: send everything upfront. Here&#x27;s the actual checklist.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">1. What You&#x27;re Commissioning</h2><p class=\"mb-4 font-sans leading-relaxed\">State the format plainly: album cover, single/EP cover, manga volume cover, book cover, or standalone illustration. This alone determines format, dimensions, and typical turnaround.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">2. Reference Images</h2><p class=\"mb-4 font-sans leading-relaxed\">Two to three pieces (any artist, any source) that capture the mood, color palette, or composition you want — not necessarily the subject matter, just the <em class=\"italic text-[var(--yellow)]\">feel</em>. This is the single highest-leverage thing you can include.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">3. Exact Title and Name Text</h2><p class=\"mb-4 font-sans leading-relaxed\">If text needs to appear on the piece — an artist name, album title, or series title — send the exact spelling and capitalization. Don&#x27;t leave this for later; typography is often planned into the composition from the start.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">4. Any Fixed Visual Elements</h2><p class=\"mb-4 font-sans leading-relaxed\">Specific characters, objects, symbols, or colors that must appear. If a character already exists (from prior art, a comic series, or a game), send existing reference art of that character.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">5. Format and Dimensions</h2><p class=\"mb-4 font-sans leading-relaxed\">Square for streaming platforms (3000x3000px is standard), a specific print size, or both. If you&#x27;re not sure, say what the final piece will be used for and let the artist confirm the right spec.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">6. Intended Use</h2><p class=\"mb-4 font-sans leading-relaxed\">Personal project, commercial release, merch, crowdfunding campaign — usage affects both pricing and the licensing terms you&#x27;ll need.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">7. Timeline</h2><p class=\"mb-4 font-sans leading-relaxed\">Your actual deadline, not a padded one. If there&#x27;s flexibility, say so — it can affect scheduling and sometimes price.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">8. Budget Range</h2><p class=\"mb-4 font-sans leading-relaxed\">A rough range (even &quot;under $X&quot; or &quot;flexible for the right fit&quot;) saves both sides time compared to quoting blind and negotiating from scratch.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">9. Mood/Tone in Your Own Words</h2><p class=\"mb-4 font-sans leading-relaxed\">Beyond references, a sentence or two on tone — dark and moody, bright and energetic, minimal and clean — helps the artist read your intent correctly, especially where references pull in slightly different directions.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">10. Anything That&#x27;s a Hard No</h2><p class=\"mb-4 font-sans leading-relaxed\">If there&#x27;s a style, color, or element you specifically don&#x27;t want, say so upfront. This is often more useful than a long list of what you do want.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Why This Matters More Than Picking &quot;The Right&quot; Artist</h2><p class=\"mb-4 font-sans leading-relaxed\">A strong brief gets a good result out of most competent artists. A vague brief creates friction even with a great one — extra rounds of clarifying questions, sketches built on guesses, and revisions that are really just filling in gaps that should&#x27;ve been in the first message.</p><p class=\"mb-4 font-sans leading-relaxed\">Structured commission processes — like the one used for <a href=\"/#order\" class=\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\">album, manga, and illustration work here</a> — are typically built around exactly this kind of upfront brief, which is why having it ready before you reach out speeds up everything downstream: the quote, the sketch stage, and the final timeline.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Final Thoughts</h2><p class=\"mb-4 font-sans leading-relaxed\">None of this is complicated — it&#x27;s just easy to skip when you&#x27;re excited to get started. Ten minutes spent gathering references and answering these questions before your first message usually saves days of back-and-forth later.</p></div><div class=\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--ink)] shadow-[10px_10px_0_var(--red)]\"><div class=\"font-mono text-xs text-[var(--red)] font-bold uppercase tracking-widest mb-1\">Ready to Commission?</div><h3 class=\"font-anton text-3xl uppercase mb-3\">Get Your Custom Artwork Stamped</h3><p class=\"text-sm font-sans text-[var(--muted)] mb-6\">Jhay Sanyay Studio handles custom cover art, manga/comic illustrations, and logo design from brief submission to final delivery. Fill out your job ticket below for a 48-hour quote.</p><a href=\"#order\" class=\"stamp-btn inline-block !py-3 !px-6\">FILL OUT JOB TICKET</a></div></div></article><section id=\"order\" class=\"ticket-build-section py-[72px] bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-[800px] mx-auto\"><div class=\"section-head mb-8 text-center\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"eyebrow font-mono text-xs text-[var(--yellow)] tracking-[0.12em] uppercase mb-[18px] inline-flex items-center gap-[10px] before:content-[&#x27;&#x27;] before:w-5 before:h-[2px] before:bg-[var(--yellow)] after:content-[&#x27;&#x27;] after:w-5 after:h-[2px] after:bg-[var(--yellow)]\">Commission Order Form</div><h2 class=\"text-[clamp(36px,6vw,56px)] font-anton uppercase text-[var(--paper)]\">Create Job Ticket</h2></div><div class=\"ticket relative bg-[var(--ink)] color-[var(--paper)] border-2 border-[var(--paper)] p-6 md:p-12 shadow-[12px_12px_0_var(--red)]\" style=\"opacity:0;transform:scale(0.95)\"><div class=\"notch tl\"></div><div class=\"notch tr\"></div><div class=\"notch bl\"></div><div class=\"notch br\"></div><div class=\"ticket-header flex justify-between items-center border-b-2 border-dashed border-[var(--paper-2)] pb-4 mb-8\"><div class=\"font-anton text-2xl tracking-wider text-[var(--yellow)]\">JHAY SANYAY STUDIO</div><div class=\"font-mono text-xs md:text-sm text-[var(--paper-2)] tracking-widest uppercase\">TICKET NO: <span class=\"font-bold text-[var(--red)]\"></span></div></div><form class=\"space-y-6\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Client / Stage Name <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. Starboy / Divine\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Email or Social Handle <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. @artist / email@domain.com\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Service Category</label><select class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"><option value=\"Single Cover Art\" selected=\"\">Single Cover Art</option><option value=\"EP / Album Art\">EP / Album Art</option><option value=\"Logo / Brand Mark\">Logo / Brand Mark</option><option value=\"Comic Page\">Comic Page</option><option value=\"Motion / Animated Cover\">Motion / Animated Cover</option></select></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Project / Release Title</label><input type=\"text\" placeholder=\"e.g. Midnight Riddim EP\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Target Release / Deadline</label><input type=\"text\" placeholder=\"e.g. Oct 15th / ASAP\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Preferred Contact Method</label><select class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"><option value=\"Email\" selected=\"\">Email</option><option value=\"Instagram DM\">Instagram DM</option><option value=\"WhatsApp\">WhatsApp</option></select></div></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Project Brief &amp; Visual Notes <span class=\"text-[var(--red)]\">*</span></label><textarea required=\"\" rows=\"4\" placeholder=\"Describe your vision, color themes, reference links, mood or key characters...\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"></textarea></div><div class=\"text-center pt-4\"><button type=\"submit\" class=\"stamp-btn\" tabindex=\"0\">STAMP &amp; GENERATE TICKET</button></div></form></div></div></section><footer class=\"bg-[var(--ink)] border-t-2 border-[var(--paper-2)] py-10 color-[var(--paper-2)]\"><div class=\"wrap flex flex-col items-center text-center gap-[10px]\"><div class=\"foot-brand font-anton text-[28px] tracking-[0.04em] text-[var(--paper)]\">JHAY SANYAY</div><div class=\"foot-sub font-mono text-[12px] text-[var(--muted)] uppercase\">Visual Artist &amp; Illustrator · Nigeria</div><div class=\"foot-links flex gap-[20px] font-mono text-[12px] mt-[10px]\"><a class=\"text-[var(--yellow)] hover:underline\" href=\"/portfolio\">Portfolio</a><a class=\"text-[var(--yellow)] hover:underline\" href=\"/blog\">Guides &amp; Blog</a><a href=\"https://linktr.ee/jhaysanyay\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[var(--yellow)] hover:underline\">Linktree ↗</a><a href=\"/#order\" class=\"text-[var(--yellow)] hover:underline\">Job Ticket</a></div><div class=\"text-[12px] text-[var(--yellow)] mt-[20px] tracking-wider uppercase\">designed by <a href=\"https://www.instagram.com/buildwithclinton/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[var(--paper)] hover:text-[var(--yellow)] hover:underline transition-colors\">buildwithclinton ↗</a></div></div></footer></main><!--$--><!--/$--><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n5:I[97367,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"OutletBoundary\\\"]\\n6:\\\"$Sreact.suspense\\\"\\n9:I[97367,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"ViewportBoundary\