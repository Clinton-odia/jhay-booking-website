order-b-2 border-[var(--ink)] text-[var(--ink)]\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"wrap max-w-4xl\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/blog\\\",\\\"className\\\":\\\"font-mono text-xs text-[var(--red)] uppercase font-bold tracking-wider hover:underline inline-block mb-6\\\",\\\"children\\\":\\\"← Back to All Guides\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 font-mono text-xs text-[var(--muted)] mb-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"bg-[var(--ink)] text-[var(--paper)] font-bold px-2 py-0.5 uppercase tracking-widest text-[10px]\\\",\\\"children\\\":\\\"Case Study\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"July 22, 2025\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"•\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"7 min read\\\"}]]}],[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"font-anton text-4xl sm:text-5xl md:text-6xl uppercase leading-tight text-[var(--ink)] mt-2\\\",\\\"children\\\":\\\"From Brief to Final Cover: A Real Commission Walkthrough\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-3 mt-6 pt-4 border-t border-[var(--ink)]/20 font-mono text-xs\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-[var(--muted)] uppercase\\\",\\\"children\\\":\\\"Written by:\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-bold text-[var(--ink)]\\\",\\\"children\\\":\\\"Jhay Sanyay\\\"}]]}]]}]}],[\\\"$\\\",\\\"article\\\",null,{\\\"className\\\":\\\"py-16 bg-[var(--ink)] text-[var(--paper)]\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"wrap max-w-3xl space-y-8 font-sans text-lg leading-relaxed text-[var(--paper-2)]/90\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"relative aspect-[16/9] w-full border-2 border-[var(--paper-2)]/30 overflow-hidden mb-10 shadow-2xl\\\",\\\"children\\\":[\\\"$\\\",\\\"$L10\\\",null,{\\\"src\\\":\\\"/images/cover-art/chance.jpg\\\",\\\"alt\\\":\\\"From Brief to Final Cover: A Real Commission Walkthrough\\\",\\\"fill\\\":true,\\\"sizes\\\":\\\"(max-width: 1024px) 100vw, 800px\\\",\\\"className\\\":\\\"object-cover\\\",\\\"priority\\\":true}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",\\\"0\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"Guides on how commissions work tend to describe the process in the abstract — brief, sketch, revisions, delivery. It's accurate, but it doesn't show what each stage actually involves in practice. Here's a real walkthrough, stage by stage.\\\"]}],[\\\"$\\\",\\\"hr\\\",\\\"2\\\",{\\\"className\\\":\\\"my-8 border-dashed border-[var(--paper-2)]/30\\\"}],[\\\"$\\\",\\\"h2\\\",\\\"4\\\",{\\\"className\\\":\\\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\\\",\\\"children\\\":\\\"Stage 1: The Initial Brief\\\"}],[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"The project starts with a client sending a reference set: two existing covers whose color mood they liked, a rough description of the scene they had in mind, and the exact title text needed. They also flagged the intended use — a streaming release, so square format at full resolution was the target.\\\"]}],[\\\"$\\\",\\\"p\\\",\\\"8\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"\\\",[\\\"$\\\",\\\"strong\\\",\\\"1\\\",{\\\"className\\\":\\\"font-bold text-[var(--paper)]\\\",\\\"children\\\":\\\"What this stage actually determines:\\\"}],\\\" scope, and therefore the quote. A brief this specific usually moves straight to a quote without a back-and-forth clarifying round, because there's nothing ambiguous left to ask about.\\\"]}],[\\\"$\\\",\\\"h2\\\",\\\"10\\\",{\\\"className\\\":\\\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\\\",\\\"children\\\":\\\"Stage 2: Quote and Timeline\\\"}],[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"Based on the brief — one main subject, a moderately detailed background, standard commercial release rights — a price and a two-week turnaround were confirmed. This is also the point where revision rounds get set explicitly, so there's no ambiguity later about how many passes are included.\\\"]}],\\\"$L11\\\",\\\"$L12\\\",\\\"$L13\\\",\\\"$L14\\\",\\\"$L15\\\",\\\"$L16\\\",\\\"$L17\\\",\\\"$L18\\\",\\\"$L19\\\",\\\"$L1a\\\",\\\"$L1b\\\",\\\"$L1c\\\",\\\"$L1d\\\",\\\"$L1e\\\",\\\"$L1f\\\",\\\"$L20\\\",\\\"$L21\\\",\\\"$L22\\\",\\\"$L23\\\",\\\"$L24\\\",\\\"$L25\\\",\\\"$L26\\\",\\\"$L27\\\"]}],\\\"$L28\\\"]}]}],\\\"$L29\\\",\\\"$L2a\\\"]}]\\n2b:I[87879,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\",\\\"/_next/static/chunks/3ykrlu0oa3rkw.js\\\"],\\\"default\\\"]\\n11:[\\\"$\\\",\\\"h2\\\",\\\"14\\\",{\\\"className\\\":\\\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\\\",\\\"children\\\":\\\"Stage 3: The Sketch Stage\\\"}]\\n12:[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"Before any color or detail work begins, a rough composition sketch goes to the client for approval. This is the cheapest point to catch a mismatch — if the pose, framing, or layout isn't right, it's a quick fix here instead of a costly rework after full rendering.\\\"]}]\\n13:[\\\"$\\\",\\\"p\\\",\\\"18\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"In this project, the first sketch was close but the client wanted the composition shifted to leave more space for the title text at the top — a five-minute adjustment at this stage that would have been a much bigger one after full color work.\\\"]}]\\n14:[\\\"$\\\",\\\"h2\\\",\\\"20\\\",{\\\"className\\\":\\\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\\\",\\\"children\\\":\\\"Stage 4: Line Art and Base Color\\\"}]\\n15:[\\\"$\\\",\\\"p\\\",\\\"22\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"Once the sketch is approved, the piece moves to full line work and base color blocking. This is usually the longest single stage, since it's where the actual detail — texture, character rendering, background elements — gets built out.\\\"]}]\\n16:[\\\"$\\\",\\\"h2\\\",\\\"24\\\",{\\\"className\\\":\\\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\\\",\\\"children\\\":\\\"Stage 5: Rendering and Lighting\\\"}]\\n17:[\\\"$\\\",\\\"p\\\",\\\"26\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"Full shading, lighting, and detail pass. This is where a flat, sketch-accurate piece turns into a finished illustration — depth, highlights, and atmosphere get added here.\\\"]}]\\n18:[\\\"$\\\",\\\"h2\\\",\\\"28\\\",{\\\"className\\\":\\\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\\\",\\\"children\\\":\\\"Stage 6: Revisions\\\"}]\\n19:[\\\"$\\\",\\\"p\\\",\\\"30\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"With the piece fully rendered, the client requested one adjustment: a slightly warmer color grade to better match their previous release's visual identity. This kind of targeted, specific revision request — tied to a clear reason — is typically the fastest kind to execute, compared to open-ended feedback like \\\\\\\"make it pop more.\\\\\\\"\\\"]}]\\n1a:[\\\"$\\\",\\\"h2\\\",\\\"32\\\",{\\\"className\\\":\\\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\\\",\\\"children\\\":\\\"Stage 7: Final Delivery\\\"}]\\n1b:[\\\"$\\\",\\\"p\\\",\\\"34\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"Final files delivered in two formats: a high-resolution print-ready file and a platform-optimized square file for streaming thumbnails. Commercial usage rights were confirmed as part of delivery, matching what was agreed at the quote stage.\\\"]}]\\n1c:[\\\"$\\\",\\\"hr\\\",\\\"36\\\",{\\\"className\\\":\\\"my-8 border-dashed border-[var(--paper-2)]/30\\\"}]\\n1d:[\\\"$\\\",\\\"h2\\\",\\\"38\\\",{\\\"className\\\":\\\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\\\",\\\"children\\\":\\\"What Made This Project Go Smoothly\\\"}]\\n1e:[\\\"$\\\",\\\"p\\\",\\\"40\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"Looking back at the whole process, a few things stand out as the actual reasons it moved efficiently:\\\"]}]\\n1f:[\\\"$\\\",\\\"li\\\",\\\"42\\\",{\\\"className\\\":\\\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\\\",\\\"children\\\":[\\\"\\\",[\\\"$\\\",\\\"strong\\\",\\\"1\\\",{\\\"className\\\":\\\"font-bold text-[var(--paper)]\\\",\\\"children\\\":\\\"The initial brief was specific\\\"}],\\\", which skipped an entire round of clarifying questions\\\"]}]\\n20:[\\\"$\\\",\\\"li\\\",\\\"43\\\",{\\\"className\\\":\\\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\\\",\\\"children\\\":[\\\"\\\",[\\\"$\\\",\\\"strong\\\",\\\"1\\\",{\\\"className\\\":\\\"font-bold text-[var(--paper)]\\\",\\\"children\\\":\\\"Sketch approval caught the one real issue early\\\"}],\\\", before it was expensive to fix\\\"]}]\\n21:[\\\"$\\\",\\\"li\\\",\\\"44\\\",{\\\"className\\\":\\\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\\\",\\\"children\\\":[\\\"\\\",[\\\"$\\\",\\\"strong\\\",\\\"1\\\",{\\\"className\\\":\\\"font-bold text-[var(--paper)]\\\",\\\"children\\\":\\\"The one revision request was specific and comparative\\\"}],\\\" (\\\\\\\"warmer, like this other cover\\\\\\\") rather than vague\\\"]}]\\n22:[\\\"$\\\",\\\"li\\\",\\\"45\\\",{\\\"className\\\":\\\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\\\",\\\"children\\\":[\\\"\\\",[\\\"$\\\",\\\"strong\\\",\\\"1\\\",{\\\"className\\\":\\\"font-bold text-[var(--paper)]\\\",\\\"children\\\":\\\"Rights and format were agreed before work started\\\"}],\\\", not negotiated at delivery\\\"]}]\\n23:[\\\"$\\\",\\\"p\\\",\\\"47\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"None of this required unusual effort from the client — just preparation before the first message, and specific feedback at each checkpoint.\\\"]}]\\n24:[\\\"$\\\",\\\"hr\\\",\\\"49\\\",{\\\"className\\\":\\\"my-8 border-dashed border-[var(--paper-2)]/30\\\"}]\\n25:[\\\"$\\\",\\\"h2\\\",\\\"51\\\",{\\\"className\\\":\\\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\\\",\\\"children\\\":\\\"Final Thoughts\\\"}]\\n26:[\\\"$\\\",\\\"p\\\",\\\"53\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"The gap between a commission that takes two weeks smoothly and one that drags on for two months usually isn't about the artist's speed — it's about how much clarity exists at each checkpoint. A specific brief, a real sketch-approval step, and targeted feedback are what make the difference.\\\"]}]\\n27:[\\\"$\\\",\\\"p\\\",\\\"55\\\",{\\\"className\\\":\\\"mb-4 font-sans leading-relaxed\\\",\\\"children\\\":[\\\"If you're planning a commission and want a process structured this way, \\\",[\\\"$\\\",\\\"a\\\",\\\"1\\\",{\\\"href\\\":\\\"/#order\\\",\\\"className\\\":\\\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\\\",\\\"children\\\":\\\"album, manga, and illustration commissions here\\\"}],\\\" follow this same brief-to-delivery flow.\\\"]}]\\n28:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--ink)] shadow-[10px_10px_0_var(--red)]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"font-mono text-xs text-[var(--red)] font-bold uppercase tracking-widest mb-1\\\",\\\"children\\\":\\\"Ready to Commission?\\\"}],[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-anton text-3xl uppercase mb-3\\\",\\\"children\\\":\\\"Get Your Custom Artwork Stamped\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-sm font-sans text-[var(--muted)] mb-6\\\",\\\"children\\\":\\\"Jhay Sanyay Studio handles custom cover art, manga/comic illustrations, and logo design from brief submission to final delivery. Fill out your job ticket below for a 48-hour quote.\\\"}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#order\\\",\\\"className\\\":\\\"stamp-btn inline-block !py-3 !px-6\\\",\\\"children\\\":\\\"FILL OUT JOB TICKET\\\"}]]}]\\n29:[\\\"$\\\",\\\"$L2b\\\",null,{}]\\n2a:[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"bg-[var(--ink)] border-t-2 border-[var(--paper-2)] py-10 color-[var(--paper-2)]\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"wrap flex flex-col items-center text-center gap-[10px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"foot-brand font-anton text-[28px] tracking-[0.04em] text-[var(--paper)]\\\",\\\"children\\\":\\\"JHAY SANYAY\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"foot-sub font-mono text-[12px] text-[var(--muted)] uppercase\\\",\\\"children\\\":\\\"Visual Artist \\u0026 Illustrator · Nigeria\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"foot-links flex gap-[20px] font-mono text-[12px] mt-[10px]\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/portfolio\\\",\\\"className\\\":\\\"text-