Sizes=\"(max-width: 1024px) 100vw, 800px\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2b2j6nos8u62l.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/3s6nzrbk-8mnv.js\"/><script src=\"/_next/static/chunks/2eg0ks0feyohg.js\" async=\"\"></script><script src=\"/_next/static/chunks/1mkbuudhndal5.js\" async=\"\"></script><script src=\"/_next/static/chunks/2-rtuqsgzmno4.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0d8_zlqdf5yql.js\" async=\"\"></script><script src=\"/_next/static/chunks/0h2qsuyze9ds1.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/3ykrlu0oa3rkw.js\" async=\"\" crossorigin=\"\"></script><title>From Brief to Final Cover: A Real Album Art Commission Walkthrough | Jhay Sanyay Studio</title><meta name=\"description\" content=\"A behind-the-scenes walkthrough of an actual cover art commission, from the first brief through sketch approval to final delivery — what each stage really looks like.\"/><meta name=\"author\" content=\"Jhay Sanyay\"/><meta name=\"keywords\" content=\"album cover commission process example,custom cover art case study,commission process behind the scenes\"/><meta name=\"creator\" content=\"Jhay Sanyay\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-image-preview:large, max-snippet:-1\"/><meta property=\"og:title\" content=\"From Brief to Final Cover: A Real Album Art Commission Walkthrough\"/><meta property=\"og:description\" content=\"A behind-the-scenes walkthrough of an actual cover art commission, from the first brief through sketch approval to final delivery — what each stage really looks like.\"/><meta property=\"og:url\" content=\"https://jhaysanyay.com/blog/commission-brief-to-final-cover-walkthrough\"/><meta property=\"og:image\" content=\"https://jhaysanyay.com/images/cover-art/chance.jpg\"/><meta property=\"og:image:alt\" content=\"From Brief to Final Cover: A Real Commission Walkthrough\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2025-07-21T23:00:00.000Z\"/><meta property=\"article:author\" content=\"Jhay Sanyay\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:creator\" content=\"@jhaysanyay\"/><meta name=\"twitter:title\" content=\"From Brief to Final Cover: A Real Album Art Commission Walkthrough\"/><meta name=\"twitter:description\" content=\"A behind-the-scenes walkthrough of an actual cover art commission, from the first brief through sketch approval to final delivery — what each stage really looks like.\"/><meta name=\"twitter:image\" content=\"https://jhaysanyay.com/images/cover-art/chance.jpg\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/icon.svg?icon.1hqt-6fdfs6lm.svg\" sizes=\"any\" type=\"image/svg+xml\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col font-sans bg-[var(--ink)] color-[var(--paper)]\"><div hidden=\"\"><!--$--><!--/$--></div><main class=\"min-h-screen flex flex-col bg-[var(--ink)]\"><header class=\"sticky top-0 z-40 bg-[var(--ink)] border-b-2 border-[var(--paper-2)] text-[var(--paper)] py-4\"><div class=\"wrap flex flex-wrap justify-between items-center gap-4\"><a class=\"font-anton text-2xl tracking-wider text-[var(--paper)] hover:text-[var(--yellow)] transition-colors relative group\" href=\"/\">JHAY <span class=\"text-[var(--red)] font-bold\">·</span> SANYAY</a><nav class=\"flex items-center gap-4 sm:gap-6 font-mono text-xs text-[var(--paper-2)] tracking-widest uppercase\"><a class=\"text-[var(--paper)] hover:text-[var(--yellow)] font-bold transition-colors\" href=\"/portfolio\">Portfolio</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/blog\">Guides</a><a class=\"hover:text-[var(--yellow)] transition-colors\" href=\"/#prices\">Prices</a><a class=\"text-[var(--yellow)] border border-[var(--yellow)] px-3 py-1 hover:bg-[var(--yellow)] hover:text-[var(--ink)] transition-all duration-300 active:scale-95\" href=\"/#order\">Book Ticket</a></nav></div></header><section class=\"bg-[var(--paper)] py-12 border-b-2 border-[var(--ink)] text-[var(--ink)]\"><div class=\"wrap max-w-4xl\"><a class=\"font-mono text-xs text-[var(--red)] uppercase font-bold tracking-wider hover:underline inline-block mb-6\" href=\"/blog\">← Back to All Guides</a><div class=\"flex items-center gap-3 font-mono text-xs text-[var(--muted)] mb-3\"><span class=\"bg-[var(--ink)] text-[var(--paper)] font-bold px-2 py-0.5 uppercase tracking-widest text-[10px]\">Case Study</span><span>•</span><span>July 22, 2025</span><span>•</span><span>7 min read</span></div><h1 class=\"font-anton text-4xl sm:text-5xl md:text-6xl uppercase leading-tight text-[var(--ink)] mt-2\">From Brief to Final Cover: A Real Commission Walkthrough</h1><div class=\"flex items-center gap-3 mt-6 pt-4 border-t border-[var(--ink)]/20 font-mono text-xs\"><span class=\"text-[var(--muted)] uppercase\">Written by:</span><span class=\"font-bold text-[var(--ink)]\">Jhay Sanyay</span></div></div></section><article class=\"py-16 bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-3xl space-y-8 font-sans text-lg leading-relaxed text-[var(--paper-2)]/90\"><div class=\"relative aspect-[16/9] w-full border-2 border-[var(--paper-2)]/30 overflow-hidden mb-10 shadow-2xl\"><img alt=\"From Brief to Final Cover: A Real Commission Walkthrough\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 1024px) 100vw, 800px\" srcSet=\"/_next/image?url=%2Fimages%2Fcover-art%2Fchance.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fcover-art%2Fchance.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fcover-art%2Fchance.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fcover-art%2Fchance.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fcover-art%2Fchance.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fcover-art%2Fchance.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fcover-art%2Fchance.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fcover-art%2Fchance.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fcover-art%2Fchance.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"space-y-4\"><p class=\"mb-4 font-sans leading-relaxed\">Guides on how commissions work tend to describe the process in the abstract — brief, sketch, revisions, delivery. It&#x27;s accurate, but it doesn&#x27;t show what each stage actually involves in practice. Here&#x27;s a real walkthrough, stage by stage.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Stage 1: The Initial Brief</h2><p class=\"mb-4 font-sans leading-relaxed\">The project starts with a client sending a reference set: two existing covers whose color mood they liked, a rough description of the scene they had in mind, and the exact title text needed. They also flagged the intended use — a streaming release, so square format at full resolution was the target.</p><p class=\"mb-4 font-sans leading-relaxed\"><strong class=\"font-bold text-[var(--paper)]\">What this stage actually determines:</strong> scope, and therefore the quote. A brief this specific usually moves straight to a quote without a back-and-forth clarifying round, because there&#x27;s nothing ambiguous left to ask about.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Stage 2: Quote and Timeline</h2><p class=\"mb-4 font-sans leading-relaxed\">Based on the brief — one main subject, a moderately detailed background, standard commercial release rights — a price and a two-week turnaround were confirmed. This is also the point where revision rounds get set explicitly, so there&#x27;s no ambiguity later about how many passes are included.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Stage 3: The Sketch Stage</h2><p class=\"mb-4 font-sans leading-relaxed\">Before any color or detail work begins, a rough composition sketch goes to the client for approval. This is the cheapest point to catch a mismatch — if the pose, framing, or layout isn&#x27;t right, it&#x27;s a quick fix here instead of a costly rework after full rendering.</p><p class=\"mb-4 font-sans leading-relaxed\">In this project, the first sketch was close but the client wanted the composition shifted to leave more space for the title text at the top — a five-minute adjustment at this stage that would have been a much bigger one after full color work.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Stage 4: Line Art and Base Color</h2><p class=\"mb-4 font-sans leading-relaxed\">Once the sketch is approved, the piece moves to full line work and base color blocking. This is usually the longest single stage, since it&#x27;s where the actual detail — texture, character rendering, background elements — gets built out.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Stage 5: Rendering and Lighting</h2><p class=\"mb-4 font-sans leading-relaxed\">Full shading, lighting, and detail pass. This is where a flat, sketch-accurate piece turns into a finished illustration — depth, highlights, and atmosphere get added here.</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Stage 6: Revisions</h2><p class=\"mb-4 font-sans leading-relaxed\">With the piece fully rendered, the client requested one adjustment: a slightly warmer color grade to better match their previous release&#x27;s visual identity. This kind of targeted, specific revision request — tied to a clear reason — is typically the fastest kind to execute, compared to open-ended feedback like &quot;make it pop more.&quot;</p><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Stage 7: Final Delivery</h2><p class=\"mb-4 font-sans leading-relaxed\">Final files delivered in two formats: a high-resolution print-ready file and a platform-optimized square file for streaming thumbnails. Commercial usage rights were confirmed as part of delivery, matching what was agreed at the quote stage.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">What Made This Project Go Smoothly</h2><p class=\"mb-4 font-sans leading-relaxed\">Looking back at the whole process, a few things stand out as the actual reasons it moved efficiently:</p><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">The initial brief was specific</strong>, which skipped an entire round of clarifying questions</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Sketch approval caught the one real issue early</strong>, before it was expensive to fix</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">The one revision request was specific and comparative</strong> (&quot;warmer, like this other cover&quot;) rather than vague</li><li class=\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\"><strong class=\"font-bold text-[var(--paper)]\">Rights and format were agreed before work started</strong>, not negotiated at delivery</li><p class=\"mb-4 font-sans leading-relaxed\">None of this required unusual effort from the client — just preparation before the first message, and specific feedback at each checkpoint.</p><hr class=\"my-8 border-dashed border-[var(--paper-2)]/30\"/><h2 class=\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\">Final Thoughts</h2><p class=\"mb-4 font-sans leading-relaxed\">The gap between a commission that takes two weeks smoothly and one that drags on for two months usually isn&#x27;t about the artist&#x27;s speed — it&#x27;s about how much clarity exists at each checkpoint. A specific brief, a real sketch-approval step, and targeted feedback are what make the difference.</p><p class=\"mb-4 font-sans leading-relaxed\">If you&#x27;re planning a commission and want a process structured this way, <a href=\"/#order\" class=\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\">album, manga, and illustration commissions here</a> follow this same brief-to-delivery flow.</p></div><div class=\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--ink)] shadow-[10px_10px_0_var(--red)]\"><div class=\"font-mono text-xs text-[var(--red)] font-bold uppercase tracking-widest mb-1\">Ready to Commission?</div><h3 class=\"font-anton text-3xl uppercase mb-3\">Get Your Custom Artwork Stamped</h3><p class=\"text-sm font-sans text-[var(--muted)] mb-6\">Jhay Sanyay Studio handles custom cover art, manga/comic illustrations, and logo design from brief submission to final delivery. Fill out your job ticket below for a 48-hour quote.</p><a href=\"#order\" class=\"stamp-btn inline-block !py-3 !px-6\">FILL OUT JOB TICKET</a></div></div></article><section id=\"order\" class=\"ticket-build-section py-[72px] bg-[var(--ink)] text-[var(--paper)]\"><div class=\"wrap max-w-[800px] mx-auto\"><div class=\"section-head mb-8 text-center\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"eyebrow font-mono text-xs text-[var(--yellow)] tracking-[0.12em] uppercase mb-[18px] inline-flex items-center gap-[10px] before:content-[&#x27;&#x27;] before:w-5 before:h-[2px] before:bg-[var(--yellow)] after:content-[&#x27;&#x27;] after:w-5 after:h-[2px] after:bg-[var(--yellow)]\">Commission Order Form</div><h2 class=\"text-[clamp(36px,6vw,56px)] font-anton uppercase text-[var(--paper)]\">Create Job Ticket</h2></div><div class=\"ticket relative bg-[var(--ink)] color-[var(--paper)] border-2 border-[var(--paper)] p-6 md:p-12 shadow-[12px_12px_0_var(--red)]\" style=\"opacity:0;transform:scale(0.95)\"><div class=\"notch tl\"></div><div class=\"notch tr\"></div><div class=\"notch bl\"></div><div class=\"notch br\"></div><div class=\"ticket-header flex justify-between items-center border-b-2 border-dashed border-[var(--paper-2)] pb-4 mb-8\"><div class=\"font-anton text-2xl tracking-wider text-[var(--yellow)]\">JHAY SANYAY STUDIO</div><div class=\"font-mono text-xs md:text-sm text-[var(--paper-2)] tracking-widest uppercase\">TICKET NO: <span class=\"font-bold text-[var(--red)]\"></span></div></div><form class=\"space-y-6\"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Client / Stage Name <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. Starboy / Divine\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Email or Social Handle <span class=\"text-[var(--red)]\">*</span></label><input type=\"text\" required=\"\" placeholder=\"e.g. @artist / email@domain.com\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Service Category</label><select class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"><option value=\"Single Cover Art\" selected=\"\">Single Cover Art</option><option value=\"EP / Album Art\">EP / Album Art</option><option value=\"Logo / Brand Mark\">Logo / Brand Mark</option><option value=\"Comic Page\">Comic Page</option><option value=\"Motion / Animated Cover\">Motion / Animated Cover</option></select></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Project / Release Title</label><input type=\"text\" placeholder=\"e.g. Midnight Riddim EP\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Target Release / Deadline</label><input type=\"text\" placeholder=\"e.g. Oct 15th / ASAP\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\" value=\"\"/></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Preferred Contact Method</label><select class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"><option value=\"Email\" selected=\"\">Email</option><option value=\"Instagram DM\">Instagram DM</option><option value=\"WhatsApp\">WhatsApp</option></select></div></div><div><label class=\"block font-mono text-xs uppercase tracking-wider text-[var(--paper-2)] mb-2\">Project Brief &amp; Visual Notes <span class=\"text-[var(--red)]\">*</span></label><textarea required=\"\" rows=\"4\" placeholder=\"Describe your vision, color themes, reference links, mood or key characters...\" class=\"w-full bg-[var(--ink)] border-2 border-[var(--paper-2)] p-3 text-[var(--paper)] font-sans focus:outline-none focus:border-[var(--yellow)] focus:-translate-y-1 transition-all duration-200\"></textarea></div><div class=\"text-center pt-4\"><button type=\"submit\" class=\"stamp-btn\" tabindex=\"0\">STAMP &amp; GENERATE TICKET</button></div></form></div></div></section><footer class=\"bg-[var(--ink)] border-t-2 border-[var(--paper-2)] py-10 color-[var(--paper-2)]\"><div class=\"wrap flex flex-col items-center text-center gap-[10px]\"><div class=\"foot-brand font-anton text-[28px] tracking-[0.04em] text-[var(--paper)]\">JHAY SANYAY</div><div class=\"foot-sub font-mono text-[12px] text-[var(--muted)] uppercase\">Visual Artist &amp; Illustrator · Nigeria</div><div class=\"foot-links flex gap-[20px] font-mono text-[12px] mt-[10px]\"><a class=\"text-[var(--yellow)] hover:underline\" href=\"/portfolio\">Portfolio</a><a class=\"text-[var(--yellow)] hover:underline\" href=\"/blog\">Guides &amp; Blog</a><a href=\"https://linktr.ee/jhaysanyay\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[var(--yellow)] hover:underline\">Linktree ↗</a><a href=\"/#order\" class=\"text-[var(--yellow)] hover:underline\">Job Ticket</a></div><div class=\"text-[12px] text-[var(--yellow)] mt-[20px] tracking-wider uppercase\">designed by <a href=\"https://www.instagram.com/buildwithclinton/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-[var(--paper)] hover:text-[var(--yellow)] hover:underline transition-colors\">buildwithclinton ↗</a></div></div></footer></main><!--$--><!--/$--><script src=\"/_next/static/chunks/3s6nzrbk-8mnv.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\"]\\n5:I[97367,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"OutletBoundary\\\"]\\n6:\\\"$Sreact.suspense\\\"\\n9:I[97367,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"ViewportBoundary\\\"]\\nb:I[97367,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"MetadataBoundary\\\"]\\nd:I[68027,[\\\"/_next/static/chunks/0h2qsuyze9ds1.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/2b2j6nos8u62l.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/7ddd198311ba7843-s.p.3kq6k02b2ysv1.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/8d05cfa5faa8406c-s.p.1s123piy9_v1m.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/9e9f04e3c37952ab-s.p.0pan85mumqyf3.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/dc0d9adbac686440-s.p.3cik_s2si-ft-.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n8:X\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"blog\\\",\\\"commission-brief-to-final-cover-walkthrough\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"blog\\\",{\\\"children\\\":[[\\\"slug\\\",\\\"commission-brief-to-final-cover-walkthrough\\\",\\\"d\\\",[]],{\\\"children\\\":[\\\"__PAGE__\\\"