k)] text-[var(--ink)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-4xl\",\"children\":[[\"$\",\"$Lf\",null,{\"href\":\"/blog\",\"className\":\"font-mono text-xs text-[var(--red)] uppercase font-bold tracking-wider hover:underline inline-block mb-6\",\"children\":\"← Back to All Guides\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 font-mono text-xs text-[var(--muted)] mb-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"bg-[var(--ink)] text-[var(--paper)] font-bold px-2 py-0.5 uppercase tracking-widest text-[10px]\",\"children\":\"Illustration Guide\"}],[\"$\",\"span\",null,{\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"November 19, 2025\"}],[\"$\",\"span\",null,{\"children\":\"•\"}],[\"$\",\"span\",null,{\"children\":\"5 min read\"}]]}],[\"$\",\"h1\",null,{\"className\":\"font-anton text-4xl sm:text-5xl md:text-6xl uppercase leading-tight text-[var(--ink)] mt-2\",\"children\":\"Concept Art vs Final Cover Art: Do You Need Both?\"}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mt-6 pt-4 border-t border-[var(--ink)]/20 font-mono text-xs\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-[var(--muted)] uppercase\",\"children\":\"Written by:\"}],[\"$\",\"span\",null,{\"className\":\"font-bold text-[var(--ink)]\",\"children\":\"Jhay Sanyay\"}]]}]]}]}],[\"$\",\"article\",null,{\"className\":\"py-16 bg-[var(--ink)] text-[var(--paper)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"wrap max-w-3xl space-y-8 font-sans text-lg leading-relaxed text-[var(--paper-2)]/90\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative aspect-[16/9] w-full border-2 border-[var(--paper-2)]/30 overflow-hidden mb-10 shadow-2xl\",\"children\":[\"$\",\"$L10\",null,{\"src\":\"/images/cover-art/cover-10.jpg\",\"alt\":\"Concept Art vs Final Cover Art: Do You Need Both?\",\"fill\":true,\"sizes\":\"(max-width: 1024px) 100vw, 800px\",\"className\":\"object-cover\",\"priority\":true}]}],[\"$\",\"div\",null,{\"className\":\"space-y-4\",\"children\":[[\"$\",\"p\",\"0\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"\\\"Concept art\\\" and \\\"final cover art\\\" sometimes get treated as the same commission at different polish levels — a rough version and a finished version of the same thing. They're not. They're solving different problems, and knowing which one you actually need saves both time and budget.\"]}],[\"$\",\"hr\",\"2\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}],[\"$\",\"h2\",\"4\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"What Concept Art Actually Is\"}],[\"$\",\"p\",\"6\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Concept art is exploratory. Its job is to answer questions that haven't been settled yet:\"]}],[\"$\",\"li\",\"8\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"What does this character actually look like, before that design exists anywhere?\"]}],[\"$\",\"li\",\"9\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"What's the visual tone of this project — dark and gritty, bright and stylized, something in between?\"]}],[\"$\",\"li\",\"10\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"What compositional direction fits a scene or idea that only exists as a description so far?\"]}],[\"$\",\"p\",\"12\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Concept art is typically looser, faster to produce, and often explores 2–3 directions rather than committing fully to one. It's a decision-making tool, not a finished deliverable.\"]}],[\"$\",\"h2\",\"14\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"What Final Cover Art Is\"}],\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\"]}],\"$L21\"]}]}],\"$L22\",\"$L23\"]}]\n24:I[87879,[\"/_next/static/chunks/0h2qsuyze9ds1.js\",\"/_next/static/chunks/3ykrlu0oa3rkw.js\"],\"default\"]\n11:[\"$\",\"p\",\"16\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Final cover art assumes those questions are already answered. Character design, tone, and general direction are settled — the job now is execution: full rendering, correct dimensions and file specs, polish, and a single committed composition ready for actual use.\"]}]\n12:[\"$\",\"h2\",\"18\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"When You Need Concept Art First\"}]\n13:[\"$\",\"li\",\"20\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"A character doesn't exist yet visually\"}],\" — you're launching something new with no established design to reference\"]}]\n14:[\"$\",\"li\",\"21\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"You're not sure what direction fits\"}],\" — you have a general idea but no strong reference point, and want to see options before committing to a full render\"]}]\n15:[\"$\",\"li\",\"22\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"The project is a series\"}],\" — establishing a visual identity through concept work before committing to a final cover helps keep every subsequent piece consistent\"]}]\n16:[\"$\",\"h2\",\"24\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"When You Can Skip Straight to Final Art\"}]\n17:[\"$\",\"li\",\"26\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"A character or visual identity already exists\"}],\" — from previous releases, existing brand art, or established series design\"]}]\n18:[\"$\",\"li\",\"27\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"You have strong, specific references\"}],\" — enough clarity that the sketch-approval stage of a normal commission serves the same \\\"check direction before committing\\\" function concept art would\"]}]\n19:[\"$\",\"li\",\"28\",{\"className\":\"ml-6 list-disc mb-2 text-[var(--paper-2)] font-sans\",\"children\":[\"\",[\"$\",\"strong\",\"1\",{\"className\":\"font-bold text-[var(--paper)]\",\"children\":\"Budget or timeline is tight\"}],\", and the project is low-risk enough that skipping a separate exploratory phase is an acceptable tradeoff\"]}]\n1a:[\"$\",\"h2\",\"30\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"A Practical Way to Decide\"}]\n1b:[\"$\",\"p\",\"32\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Ask: \",[\"$\",\"em\",\"1\",{\"className\":\"italic text-[var(--yellow)]\",\"children\":\"if the final piece came back and the direction was wrong, how expensive would that be to fix?\"}],\" If the answer is \\\"very\\\" — a series launch, a new artist's first visual identity, a big release — a concept phase is worth the extra step. If the answer is \\\"not very\\\" — a single with strong references and low stakes if a revision is needed — going straight to a normal commission with a sketch-approval stage is usually enough.\"]}]\n1c:[\"$\",\"h2\",\"34\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"How This Fits Into a Normal Commission Process\"}]\n1d:[\"$\",\"p\",\"36\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Most structured commissions already include a sketch/composition approval stage, which does some of what concept art does — it's just narrower, checking one direction rather than exploring several. For projects with genuinely unresolved creative questions, a dedicated concept phase before the main commission — as offered through \",[\"$\",\"a\",\"1\",{\"href\":\"/#order\",\"className\":\"text-[var(--yellow)] font-bold underline hover:text-[var(--red)] transition-colors\",\"children\":\"album, manga, and illustration work here\"}],\" — is worth treating as its own step rather than folding it into a single commission and hoping the first sketch lands right.\"]}]\n1e:[\"$\",\"hr\",\"38\",{\"className\":\"my-8 border-dashed border-[var(--paper-2)]/30\"}]\n1f:[\"$\",\"h2\",\"40\",{\"className\":\"font-anton text-3xl uppercase text-[var(--paper)] mt-12 mb-4 pt-6 border-t border-dashed border-[var(--paper-2)]/20\",\"children\":\"Final Thoughts\"}]\n20:[\"$\",\"p\",\"42\",{\"className\":\"mb-4 font-sans leading-relaxed\",\"children\":[\"Concept art and final cover art aren't a \\\"cheap version vs. expensive version\\\" of the same thing — they answer different questions. Knowing which question you're actually trying to answer is what determines whether you need one, the other, or both.\"]}]\n21:[\"$\",\"div\",null,{\"className\":\"mt-16 p-8 bg-[var(--paper)] text-[var(--ink)] border-2 border-[var(--ink)] shadow-[10px_10px_0_var(--red)]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"font-mono text-xs text-[var(--red)] font-bold uppercase tracking-widest mb-1\",\"children\":\"Ready to Commission?\"}],[\"$\",\"h3\",n